# URL pública del backend (se incrusta en el navegador)
NEXT_PUBLIC_API_URL="http://localhost:3001/api"

# WebSocket — URL base del backend para socket.io (sin /api, sin trailing slash)
# En producción: la URL pública del backend (ej. "https://api.tudominio.es")
NEXT_PUBLIC_WS_URL="http://localhost:3001"

# Auth.js — secreto de servidor (NO expuesto al cliente)
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Observabilidad (servidor Next.js — captura errores de Server Components,
# Route Handlers y Server Actions). Vacío en desarrollo/test.
# En producción: DSN del proyecto en sentry.io > Project Settings > Client Keys.
SENTRY_DSN=