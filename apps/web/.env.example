# URL pública del backend (se incrusta en el navegador)
NEXT_PUBLIC_API_URL="http://localhost:3001/api"

# WebSocket — URL base del backend para socket.io (sin /api, sin trailing slash)
# En producción: la URL pública del backend (ej. "https://api.tudominio.es")
NEXT_PUBLIC_WS_URL="http://localhost:3001"

# Auth.js — secreto de servidor (NO expuesto al cliente)
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# ISR revalidación on-demand (blog, páginas, footer) — debe coincidir con
# REVALIDATE_SECRET de apps/api. Sin esto, /api/revalidate siempre devuelve 401
# y BlogService.revalidate()/revalidateTag() fallan en silencio (fire-and-forget) —
# el contenido sigue apareciendo, pero solo tras expirar el TTL de cada cache
# (hasta 1h para el footer, hasta 1h para /blog y /paginas), no al instante.
REVALIDATE_SECRET=""

# Observabilidad — servidor Next.js (Server Components, Route Handlers, Server
# Actions). Variable privada de servidor, nunca expuesta al navegador.
# Vacío en desarrollo/test → SDK desactivado.
SENTRY_DSN=

# Observabilidad — cliente/navegador (hydration failures, errores de clic,
# fetch fallidos en el browser). Debe tener prefijo NEXT_PUBLIC_ para que
# Next.js la incruste en el bundle del cliente.
# SEGURIDAD: Un DSN de Sentry NO es un secreto. Solo permite enviar eventos;
# no da acceso de lectura ni admin. Es seguro exponerlo en el bundle público.
# Puede ser el mismo DSN que SENTRY_DSN o un proyecto Sentry separado.
# Vacío en desarrollo/test → SDK desactivado.
NEXT_PUBLIC_SENTRY_DSN=

# Mapa — tiles vectoriales de MapTiler (clave PÚBLICA por diseño: solo sirve tiles).
# Crear una clave restringida por dominio en maptiler.com para producción.
NEXT_PUBLIC_MAPTILER_KEY=

# Medios — el ESPEJO de S3_PUBLIC_URL de apps/api. De aquí sale el dominio que
# `next/image` autoriza (`remotePatterns`) y que `isSafeSrc` deja pintar; sin él,
# en producción NO SE VE NI UNA IMAGEN aunque la red funcione.
#
# Los dos avisos, en orden de lo caro que sale olvidarlos:
#  1. NEXT_PUBLIC_* se incrusta AL CONSTRUIR, no al arrancar: tiene que estar
#     definida cuando corre `next build`, o el bundle sale sin el dominio.
#  2. Debe apuntar al MISMO sitio que S3_PUBLIC_URL, y las dos hay que fijarlas
#     ANTES de la primera subida — la URL pública se guarda entera en la base de
#     datos y cambiar la variable después no reescribe lo ya guardado.
#
# Producción: el dominio propio del bucket R2 (o su `https://pub-<hash>.r2.dev`).
# Desarrollo: se puede dejar vacía — localhost y 127.0.0.1 ya están autorizados.
NEXT_PUBLIC_MEDIA_URL=

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=