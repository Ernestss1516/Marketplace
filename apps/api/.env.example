# IMPORTANTE (Windows + Docker Desktop): usar 127.0.0.1, NUNCA localhost, en las
# conexiones a los contenedores. Node resuelve "localhost" a ::1 primero, y el
# reenvío de puertos IPv6 de Docker Desktop acepta el connect y corta al primer
# byte -> ECONNRESET/ECONNABORTED (errno -4077/-4079) en bucle. Ver CLAUDE.md.

# Base de datos
DATABASE_URL="postgresql://marketplace:marketplace_dev@127.0.0.1:5432/marketplace"

# Redis — db 0 (default) for dev. In .env.test, use a non-zero db (e.g. .../1)
# so the e2e suite never collides with a running dev server on the same Redis.
REDIS_URL="redis://127.0.0.1:6379"

# Meilisearch
MEILI_HOST="http://127.0.0.1:7700"
MEILI_MASTER_KEY="masterKey_dev_change_me"

# Autenticación
JWT_SECRET="change_me_in_production_use_a_long_random_string"
JWT_EXPIRES_IN="7d"

# Almacenamiento de imágenes (Cloudflare R2 o MinIO local)
# MinIO dev: docker run -p 9000:9000 -p 9001:9001 minio/minio server /data --console-address ":9001"
S3_ENDPOINT="http://127.0.0.1:9000"
S3_BUCKET="marketplace"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_PUBLIC_URL="http://127.0.0.1:9000/marketplace"

# Email (Resend)
RESEND_API_KEY="re_your_api_key_here"
RESEND_FROM="noreply@tudominio.es"

# URLs
APP_URL="http://localhost:3000"

# ISR revalidación on-demand (blog): debe coincidir con REVALIDATE_SECRET de apps/web.
# Si no se define, la revalidación on-demand del blog queda desactivada (el ISR de 1 h sigue activo).
REVALIDATE_SECRET="change_me_same_as_web"

# App
PORT=3001
NODE_ENV=development

# Geocoding (búsqueda por proximidad — resuelve lat/lng al publicar anuncios)
# "nominatim": OpenStreetMap, gratuito, sin key — límite 1 req/s, válido para dev.
# "maptiler":  MapTiler Cloud, requiere MAPTILER_API_KEY — fiable para producción.
# Para activar MapTiler en producción: SOLO es cambio de config, cero código.
GEOCODING_PROVIDER=nominatim
# Requerida únicamente si GEOCODING_PROVIDER=maptiler:
# MAPTILER_API_KEY=your_maptiler_api_key_here

# Stripe (facturación — RF.3+ los usará; RF.2 solo documenta)
# NUNCA poner aquí una clave real: este fichero SÍ se versiona. Las de verdad
# van en el `.env` local, que está ignorado. Estas dos líneas llevaron una
# `sk_test_` y un `whsec_` completos hasta 2026-09-02; ver
# docs/auditoria-despliegue.md §3.8.
# Claves disponibles en dashboard.stripe.com > Developers > API keys
STRIPE_SECRET_KEY=sk_test_your_stripe_test_key_here
# Clave de firma de webhooks: Stripe CLI → stripe listen, o dashboard > Webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here
# IDs de Price de Stripe (se crean en el dashboard o via Stripe CLI)
# Deben coincidir con los registros Price.gatewayPriceId en base de datos
STRIPE_PRICE_FEATURED_7D=price_...
STRIPE_PRICE_FEATURED_14D=price_...
STRIPE_PRICE_FEATURED_30D=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...

# Redsys (facturación — RF.5+ lo usará; RF.4 solo documenta las variables)
# Credenciales del TPV Redsys de Caixabank / Banco Sabadell u otro banco adquirente.
# Dejar vacío en desarrollo y test; el backend arranca correctamente sin ellas.
REDSYS_MERCHANT_CODE=       # Ds_MerchantCode: código de comercio asignado por el banco
REDSYS_TERMINAL=001         # Terminal (normalmente "001")
REDSYS_SECRET_KEY=          # Clave del comercio en base64 (para firma HMAC-SHA256-V1)
REDSYS_ENVIRONMENT=test     # "test" (https://sis-t.redsys.es) | "production" (https://sis.redsys.es)
REDSYS_NOTIFICATION_URL=    # URL pública de POST /webhooks/redsys (sin JWT; debe ser HTTPS en producción)

# Observabilidad
# Sentry: vacío en desarrollo y test (el SDK se desactiva solo si DSN es vacío).
# En producción: obtener el DSN en sentry.io > Project Settings > Client Keys.
SENTRY_DSN=

# Login social con Google (H7). Solo el client ID — el backend verifica firmas de
# id_token con las claves públicas de Google; nunca intercambia código con Google
# (eso lo hace Next-Auth en apps/web). Vacío en dev/test; requerido en producción.
# Se obtiene en Google Cloud Console > APIs & Services > Credentials.
GOOGLE_CLIENT_ID=

# Formulario de contacto público (RC.1)
# Firma el token del time-trap anti-bot — dedicado, NUNCA reutilizar JWT_SECRET.
CONTACT_FORM_SECRET=change_me_use_a_long_random_string
# Nº de saltos de proxy de confianza delante de la API en producción (nginx,
# Cloudflare, etc.) — usado por app.set('trust proxy', N) para que el rate
# limit por IP del formulario de contacto no sea falsificable. Ajustar a la
# topología real de despliegue.
TRUST_PROXY_HOPS=1