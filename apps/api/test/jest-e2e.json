{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "test/.*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/src/$1"
  },
  "setupFiles": ["<rootDir>/test/load-env.ts"],
  "globalSetup": "<rootDir>/test/setup-e2e.js",
  "globalTeardown": "<rootDir>/test/teardown-e2e.js",
  "testTimeout": 30000,
  "forceExit": true
}
