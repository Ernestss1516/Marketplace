# Test environment — same Docker services as dev, different identifiers.
# See docs/estrategia-testing.md §3 for the isolation strategy.
# DO NOT commit this file (same convention as .env).

# Postgres: separate database on the same server
DATABASE_URL="postgresql://marketplace:marketplace_dev@localhost:5432/marketplace_test"

# Redis: DB index 1 (dev uses index 0)
REDIS_URL="redis://localhost:6379/1"

# Meilisearch: same instance, dedicated test index
MEILI_HOST="http://localhost:7700"
MEILI_MASTER_KEY="masterKey_dev_change_me"
MEILI_INDEX_NAME="listings_test"

# Auth
JWT_SECRET="test_jwt_secret_not_for_production_use_only"
JWT_EXPIRES_IN="7d"

# Storage: separate bucket on the same MinIO instance
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="marketplace-test"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_PUBLIC_URL="http://localhost:9000/marketplace-test"

# Email: Resend calls are made but the key is a dummy so no real emails are sent
RESEND_API_KEY="re_test_noop_no_real_emails"
RESEND_FROM="test@example.com"

# App
APP_URL="http://localhost:3000"
PORT=3099
NODE_ENV=test

# Geocoding: provider stays nominatim but test listings always include coordinates,
# so geocoding is never triggered during tests
GEOCODING_PROVIDER=nominatim

# Observability: Sentry disabled in tests (empty DSN = no events sent)
SENTRY_DSN=
