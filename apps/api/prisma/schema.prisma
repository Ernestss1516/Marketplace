// ============================================================================
//  schema.prisma — Modelo de datos del marketplace (PostgreSQL)
//  Fuente única de verdad de la persistencia. Lo consume NestJS vía PrismaClient.
// ============================================================================

generator client {
  provider = "prisma-client-js"
  // postgresqlExtensions habilita extensiones de Postgres (p. ej. PostGIS) desde el schema.
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // PostGIS para búsquedas geográficas por radio (ver nota en el modelo Listing).
  extensions = [postgis]
}

// ============================================================================
//  ENUMS
// ============================================================================

/// Estado de un post de blog.
enum PostStatus {
  DRAFT       // Borrador, no visible públicamente
  PUBLISHED   // Publicado, indexado en sitemap
}

/// Rol del usuario. Gobierna el acceso al backoffice (RolesGuard en NestJS).
enum Role {
  USER
  MODERATOR
  ADMIN
}

/// Estado de la cuenta de usuario.
enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

/// Ciclo de vida de un anuncio. Modela el flujo de publicación y moderación.
enum ListingStatus {
  DRAFT           // Borrador, aún no enviado
  PENDING_REVIEW  // En espera de moderación
  ACTIVE          // Publicado y visible
  RESERVED        // Reservado a un comprador
  SOLD            // Vendido
  EXPIRED         // Caducado
  REJECTED        // Rechazado por moderación
}

/// Un anuncio puede ofrecer un producto o un servicio.
enum ListingType {
  PRODUCT
  SERVICE
}

/// Estado del artículo (aplica sobre todo a productos).
enum Condition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  FOR_PARTS
}

/// Tipo de precio de un anuncio.
enum PriceType {
  FIXED       // Precio fijo
  FREE        // Gratis (price = 0)
  NEGOTIABLE  // A convenir
}

/// Motivo de una denuncia, para la cola de moderación.
enum ReportReason {
  SPAM
  FRAUD
  INAPPROPRIATE
  PROHIBITED_ITEM
  WRONG_CATEGORY
  FAKE_REVIEW
  OTHER
}

/// Estado de gestión de una denuncia.
enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  DISMISSED
}

// ============================================================================
//  USUARIOS
// ============================================================================

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  passwordHash  String
  name          String
  /// Slug único para la URL del perfil público (SEO): /vendedor/{slug}
  slug          String     @unique
  phone         String?
  avatarUrl     String?
  bio           String?    @db.Text
  role          Role       @default(USER)
  status        UserStatus @default(ACTIVE)
  emailVerified Boolean    @default(false)

  // Ubicación para mostrar y prefiltrar
  city          String?
  province      String?
  postalCode    String?

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // --- Relaciones ---
  listings            Listing[]
  favorites           Favorite[]
  buyerConvos         Conversation[]      @relation("BuyerConversations")
  sellerConvos        Conversation[]      @relation("SellerConversations")
  messages            Message[]
  reviewsAuthored     Review[]            @relation("ReviewAuthor")
  reviewsReceived     Review[]            @relation("ReviewTarget")
  reportsMade         Report[]            @relation("Reporter")
  reportsReceived     Report[]            @relation("ReportedUser")
  reportsResolved     Report[]            @relation("ReportResolver")
  verificationTokens  VerificationToken[]
  passwordResetTokens PasswordResetToken[]
  uploadedImages      ListingImage[]       @relation("UploadedImages")
  auditLogsActed      AuditLog[]           @relation("AuditLogActor")
  posts               Post[]               @relation("PostAuthor")

  @@index([status])
}

// ============================================================================
//  CATEGORÍAS (árbol jerárquico autorreferenciado)
// ============================================================================

model Category {
  id        String  @id @default(cuid())
  name      String
  /// Slug único para la URL de listado (SEO): /{slug}
  slug      String  @unique
  iconUrl   String?
  order     Int     @default(0)

  // Auto-relación: una categoría puede tener una categoría padre y subcategorías.
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")

  /// Definición de los atributos esperados para esta categoría (nombre, tipo,
  /// opciones, si es filtrable…). El frontend la usa para pintar el formulario
  /// de publicación y los filtros; los valores concretos viven en Listing.attributes.
  attributeSchema Json @default("[]")

  listings  Listing[]

  @@index([parentId])
}

// ============================================================================
//  ANUNCIOS (núcleo del dominio)
// ============================================================================

model Listing {
  id          String        @id @default(cuid())
  title       String
  /// Slug único para la ficha (SEO): /anuncio/{slug}
  slug        String        @unique
  description String        @db.Text

  // Decimal (no Float) para evitar errores de redondeo en importes monetarios.
  price       Decimal       @db.Decimal(12, 2)
  currency    String        @default("EUR")

  type        ListingType
  condition   Condition?    // Nulo en servicios
  priceType   PriceType     @default(FIXED)
  status      ListingStatus @default(DRAFT)

  /// jsonb con los atributos variables según la categoría.
  /// Coche → { km, año, combustible, cambio }; Inmueble → { m2, habitaciones, planta }…
  /// Evita una tabla de columnas distintas por categoría. La búsqueda y el filtrado
  /// fino de estos campos se delegan en Meilisearch.
  attributes  Json          @default("{}")

  // --- Ubicación ---
  city        String?
  province    String?
  postalCode  String?
  latitude    Float?
  longitude   Float?
  // NOTA PostGIS: para búsquedas por radio eficientes ("anuncios a 10 km") se
  // añade en una migración SQL una columna geography(Point, 4326) con índice GiST,
  // poblada desde latitude/longitude. Prisma la trata como campo no gestionado.

  viewCount   Int           @default(0)

  publishedAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // --- Relaciones ---
  sellerId    String
  seller      User          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id])

  images        ListingImage[]
  favorites     Favorite[]
  conversations Conversation[]
  reports       Report[]
  reviews       Review[]

  // Índices para los filtros y ordenaciones más frecuentes (rendimiento de listados).
  @@index([categoryId, status])
  @@index([status, publishedAt])
  @@index([sellerId])
  @@index([price])
  @@index([province, city])
}

model ListingImage {
  id        String   @id @default(cuid())
  url       String
  alt       String?
  width     Int?
  height    Int?
  order     Int      @default(0)

  listingId    String?
  listing      Listing? @relation(fields: [listingId], references: [id], onDelete: Cascade)

  uploadedById String?
  uploadedBy   User?    @relation("UploadedImages", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([listingId])
  @@index([uploadedById])
}

// ============================================================================
//  FAVORITOS
// ============================================================================

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  // Un usuario no puede marcar el mismo anuncio dos veces.
  @@unique([userId, listingId])
  @@index([userId])
}

// ============================================================================
//  MENSAJERÍA (conversación por anuncio entre comprador y vendedor)
// ============================================================================

model Conversation {
  id            String    @id @default(cuid())
  listingId     String
  listing       Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId       String
  buyer         User      @relation("BuyerConversations", fields: [buyerId], references: [id])
  sellerId      String
  seller        User      @relation("SellerConversations", fields: [sellerId], references: [id])

  lastMessageAt DateTime  @default(now())
  createdAt     DateTime  @default(now())

  messages      Message[]

  // Una sola conversación por (anuncio, comprador).
  @@unique([listingId, buyerId])
  @@index([buyerId])
  @@index([sellerId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  body           String       @db.Text
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

// ============================================================================
//  VALORACIONES (reputación)
// ============================================================================

model Review {
  id        String    @id @default(cuid())
  rating    Int       // 1..5 (validado en el DTO)
  comment   String?   @db.Text

  authorId  String
  author    User      @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  targetId  String
  target    User      @relation("ReviewTarget", fields: [targetId], references: [id], onDelete: Cascade)
  // Non-nullable: elegibilidad siempre requiere un anuncio concreto
  listingId String
  listing   Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  // null hasta la primera edición; frontend muestra indicador "Editada" cuando no es null
  editedAt  DateTime?

  reports   Report[]

  // [authorId, targetId, listingId] permite bidireccionalidad:
  // buyer→seller y seller→buyer son filas distintas sobre el mismo anuncio.
  @@unique([authorId, targetId, listingId])
  @@index([targetId])
  @@index([listingId])
}

// ============================================================================
//  MODERACIÓN (denuncias)
// ============================================================================

model Report {
  id             String       @id @default(cuid())
  reason         ReportReason
  description    String?      @db.Text
  status         ReportStatus @default(PENDING)

  reporterId     String
  reporter       User         @relation("Reporter", fields: [reporterId], references: [id])

  // Una denuncia apunta a un anuncio o a un usuario (al menos uno).
  listingId      String?
  listing        Listing?     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reportedUserId String?
  reportedUser   User?        @relation("ReportedUser", fields: [reportedUserId], references: [id])

  // Auditoría de la resolución por parte de un moderador.
  resolvedById   String?
  resolvedBy     User?        @relation("ReportResolver", fields: [resolvedById], references: [id])
  resolvedAt     DateTime?

  // Una denuncia puede apuntar a una valoración (además de a listing o user)
  reviewId       String?
  review         Review?      @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  createdAt      DateTime     @default(now())

  @@index([status])
  @@index([listingId])
  @@index([reviewId])
}

// ============================================================================
//  AUDITORÍA (backoffice)
// ============================================================================

/// Registro inmutable de cada acción administrativa sensible.
/// DECISIÓN DE DISEÑO: capturado mediante AuditLogService inyectado en el
/// service de dominio, NUNCA con un interceptor de NestJS. El interceptor no
/// tiene acceso al estado de Prisma antes de la mutación (el campo `before`
/// requiere leer el recurso justo antes de modificarlo, dentro del service).
model AuditLog {
  id           String   @id @default(cuid())

  /// Convención SCREAMING_SNAKE_CASE:
  /// LISTING_DEACTIVATE | LISTING_RESTORE | LISTING_APPROVE | LISTING_REJECT
  /// USER_SUSPEND | USER_BAN | USER_REINSTATE | USER_ROLE_CHANGE
  /// REPORT_RESOLVE | REPORT_DISMISS
  /// CATEGORY_CREATE | CATEGORY_EDIT | CATEGORY_DELETE | CATEGORY_REORDER
  /// SETTING_UPDATE
  action       String

  actorId      String
  actor        User     @relation("AuditLogActor", fields: [actorId], references: [id])

  /// "Listing" | "User" | "Report" | "Category" | "Setting"
  resourceType String
  resourceId   String

  /// Snapshot del estado ANTES de la mutación. Null si no aplica (p.ej. primera
  /// escritura de un Setting).
  before       Json?

  /// Snapshot del estado DESPUÉS de la mutación.
  after        Json?

  /// IP del actor para auditoría de seguridad (extraída del request).
  ip           String?

  createdAt    DateTime @default(now())

  @@index([actorId])
  @@index([resourceType, resourceId])
  @@index([createdAt])
}

// ============================================================================
//  AJUSTES DEL SISTEMA (backoffice)
// ============================================================================

/// Configuración del sistema editable desde el backoffice sin despliegue.
/// Keys conocidas: badWordList (string[]), listingExpiryDays (number),
/// contactRequiresVerification (boolean).
/// Sembradas en seed.ts con createMany + skipDuplicates para no pisar valores
/// que el admin haya cambiado manualmente.
model Setting {
  /// Clave única del ajuste (ej. "badWordList").
  key          String   @id

  /// Valor serializado como JSON. El tipo concreto depende de la key.
  value        Json

  updatedAt    DateTime @updatedAt

  /// ID del admin que actualizó el ajuste por última vez (null en seed inicial).
  updatedById  String?
}

// ============================================================================
//  AUTH TOKENS (verificación de email y recuperación de contraseña)
// ============================================================================

model VerificationToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ============================================================================
//  BLOG
// ============================================================================

/// Post editorial del blog, gestionado exclusivamente desde el backoffice admin.
/// El cuerpo se almacena como Markdown raw; la conversión a HTML ocurre en el
/// frontend (react-markdown + rehype-sanitize) para evitar XSS almacenado.
model Post {
  id              String     @id @default(cuid())
  title           String
  /// Slug único para la URL pública: /blog/{slug}
  slug            String     @unique
  /// Resumen corto: aparece en tarjetas de listado y como meta description fallback.
  excerpt         String?    @db.Text
  /// Cuerpo en Markdown raw.
  body            String     @db.Text @default("")
  status          PostStatus @default(DRAFT)
  /// URL de la imagen de portada (obtenida vía POST /media/upload).
  coverUrl        String?
  /// Overrides SEO opcionales; si son null se usan title/excerpt como fallback.
  metaTitle       String?
  metaDescription String?    @db.Text
  /// Etiquetas planas como slugs (p.ej. ["consejos", "segunda-mano"]).
  tags            String[]   @default([])
  authorId        String
  author          User       @relation("PostAuthor", fields: [authorId], references: [id])
  publishedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([status, publishedAt])
}
