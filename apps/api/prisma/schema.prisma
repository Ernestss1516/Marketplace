// ============================================================================
//  schema.prisma — Modelo de datos del marketplace (PostgreSQL)
//  Fuente única de verdad de la persistencia. Lo consume NestJS vía PrismaClient.
// ============================================================================

generator client {
  provider        = "prisma-client-js"
  // postgresqlExtensions habilita extensiones de Postgres (p. ej. PostGIS) desde el schema.
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // PostGIS para búsquedas geográficas por radio (ver nota en el modelo Listing).
  extensions = [postgis]
}

// ============================================================================
//  ENUMS
// ============================================================================

/// Estado de un post de blog.
enum PostStatus {
  DRAFT // Borrador, no visible públicamente
  PUBLISHED // Publicado, indexado en sitemap
}

/// Tipo de contenido de un Post: artículo de blog o página informativa estática
/// (términos, privacidad...). Comparten modelo, editor y renderizado seguro;
/// difieren en presentación y namespace de URL (/blog/ vs /paginas/).
enum PostType {
  POST
  PAGE
}

/// Rol del usuario. Gobierna el acceso al backoffice (RolesGuard en NestJS).
enum Role {
  USER
  MODERATOR
  ADMIN
  EDITOR
}

/// Estado de la cuenta de usuario.
enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

/// Ciclo de vida de un anuncio. Modela el flujo de publicación y moderación.
enum ListingStatus {
  DRAFT // Borrador, aún no enviado
  PENDING_REVIEW // En espera de moderación
  ACTIVE // Publicado y visible
  RESERVED // Reservado a un comprador
  SOLD // Vendido
  EXPIRED // Caducado
  REJECTED // Rechazado por moderación
  /// Ciclo de vida RÁFAGA 2 — temporal, reactivable (PAUSED → ACTIVE), ambos
  /// tipos. Ni cuenta para la cuota de activos ni se indexa (ambos ya excluyen
  /// por construcción cualquier status != ACTIVE, sin cambios ahí). El cron de
  /// expiración tampoco la toca (solo consulta status=ACTIVE) — no hace falta
  /// congelar expiresAt; se recalcula al reactivar (ver reactivate()).
  PAUSED
  /// Ciclo de vida RÁFAGA 2 — permanente, IRREVERSIBLE, ambos tipos. Ninguna
  /// transición sale de este estado; remove() (borrado físico) sigue siendo
  /// la única vía posterior. A diferencia de remove(), no destruye
  /// conversaciones/tratos/valoraciones — es la alternativa no destructiva.
  ARCHIVED
}

/// Un anuncio puede ofrecer un producto o un servicio.
/// ETIQUETA INTERNA (P1) — el CICLO del triaje del staff. Tres valores que se
/// EXCLUYEN entre sí, que es justo lo que lo hace un enum y no una tabla de
/// etiquetas: «nuevo Y revisado a la vez» no significa nada y no debe poder
/// escribirse. (Lo que sí es multivaluado son las etiquetas públicas, y por eso
/// `ListingTag` sí es una tabla.)
enum ListingTriage {
  /// Nadie del staff lo ha mirado. Es el estado de partida de todo anuncio.
  NEW

  /// Alguien del staff lo miró y lo dio por bueno. Sólo se llega a mano.
  REVIEWED

  /// Lo que el staff dio por bueno HA CAMBIADO: el dueño lo editó después de la
  /// revisión, así que aquel juicio caducó. Se llega SÓLO automáticamente y SÓLO
  /// desde REVIEWED — editar algo que nadie había mirado no produce información
  /// nueva, y marcarlo destruiría el dato útil («sigue sin revisar»).
  EDITED
}

enum ListingType {
  PRODUCT
  SERVICE
}

/// Qué tipo(s) de anuncio admite una categoría. Vive en su propia columna de
/// Category — nunca en el canal Json de attributeSchema/Listing.attributes —
/// para no repetir la colisión de nombres ya sufrida entre un atributo de
/// categoría y el campo core `type` (ver Deuda `type` → `itemType`, RC5.2).
enum ListingTypePolicy {
  PRODUCT_ONLY
  SERVICE_ONLY
  BOTH
}

/// Vistas de resultados disponibles en /busqueda y /[categoria] (RÁFAGA 2 —
/// vistas configurables). LISTA = cards estándar (grid, la de siempre),
/// AMPLIADA = una columna con card ancha (hasta 6 atributos + descripción),
/// MAPA = vista de mapa.
enum ListingViewMode {
  LISTA
  AMPLIADA
  MAPA
}

/// Estado del artículo (aplica sobre todo a productos).
enum Condition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  FOR_PARTS
}

/// Tipo de precio de un anuncio.
enum PriceType {
  FIXED // Precio fijo
  FREE // Gratis (price = 0)
  NEGOTIABLE // A convenir
}

/// Unidad de medida del importe de un anuncio (RP.1 — formatos de precio).
/// ORTOGONAL a PriceType, no una extensión suya: PriceType dice si hay importe
/// y si es firme ("¿gratis? ¿a convenir?"), PriceUnit dice por qué unidad se
/// cobra ese importe ("¿al mes? ¿por hora?"). Los dos ejes se combinan — un
/// alquiler puede ser a la vez NEGOTIABLE y PER_MONTH. Fusionarlos en un solo
/// enum multiplicaría los valores de facet en Meilisearch y cambiaría en
/// silencio el significado de las alertas ya guardadas (Alert.priceType).
/// ONE_TIME es el default y describe correctamente todos los anuncios
/// anteriores a esta migración — sin backfill.
enum PriceUnit {
  ONE_TIME // Pago único
  PER_MONTH // Al mes
  PER_WEEK // A la semana
  PER_DAY // Al día
  PER_HOUR // Por hora
  PER_UNIT // Por unidad
  PER_SESSION // Por sesión
}

// ============================================================================
//  ENUMS DE FACTURACIÓN
// ============================================================================

enum ProductType {
  ONE_TIME // Pago único (destacado de anuncio)
  RECURRING // Suscripción recurrente (Plan Pro)
}

enum PriceInterval {
  MONTH
  YEAR
}

enum SubscriptionStatus {
  ACTIVE // Activa y se renovará automáticamente
  CANCELING // Cancelada por el usuario; sigue activa hasta currentPeriodEnd
  CANCELED // Expirada definitivamente
  PAST_DUE // Pago fallido; en período de reintento por la pasarela
}

enum TransactionStatus {
  PENDING // Esperando confirmación de la pasarela
  SUCCEEDED // Cobro confirmado
  FAILED // Cobro fallido definitivamente
  REFUNDED // Devuelto íntegramente
  PARTIALLY_REFUNDED
}

enum EntitlementType {
  PRO_SUBSCRIPTION // Acceso al Plan Pro (nivel de usuario)
  FEATURED_LISTING // Anuncio destacado (nivel de anuncio)
}

/// Origen de un Entitlement FEATURED_LISTING (H8.1). Distingue las dos bolsas
/// de destacados: la cuota mensual gratis de Pro (PRO_QUOTA, caduca con el
/// periodo de facturación — ver EntitlementService en H8.2) de los destacados
/// adquiridos por créditos o pago directo (no caducan). Irrelevante para
/// PRO_SUBSCRIPTION.
enum FeaturedOrigin {
  CREDITS // featuredByCredits — débito de Wallet
  REDSYS // pago directo vía Redsys
  PRO_QUOTA // cuota mensual gratis de Pro
  COUPON // canje de cupón (H8 Bloque D fase 3)
}

enum CreditLedgerType {
  PACK_PURCHASE // Compra de pack de créditos → entrada (positivo)
  FEATURED_DEBIT // Destacado pagado con créditos → salida (negativo)
  BUMP_DEBIT // Bump pagado con créditos → salida (negativo)
  ADMIN_CREDIT // Acreditación manual de soporte → entrada
  ADMIN_DEBIT // Débito manual de soporte → salida
  PRO_BONUS // Créditos extra concedidos a usuarios Pro al comprar un pack → entrada
  CAMPAIGN_BONUS // Créditos extra concedidos por una campaña promocional al comprar un pack → entrada
  COUPON_REDEEM // Créditos otorgados al canjear un cupón → entrada (H8 Bloque D fase 3)
}

/// Monetización ráfaga 2 — movimientos de BumpLedger (saldo de bumps, moneda
/// separada de los créditos: solo vale para bumps, intransferible). Mismo
/// molde que CreditLedgerType, ámbito reducido a lo que existe hoy para esta
/// moneda (sin PACK_PURCHASE: los bumps NO se compran directamente, solo se
/// conceden por cupón o a mano por soporte — ver diseno-facturacion.md).
enum BumpLedgerType {
  COUPON_REDEEM // Bumps otorgados al canjear un cupón → entrada
  BUMP_DEBIT // Bump pagado con saldo de bumps → salida
  ADMIN_CREDIT // Acreditación manual de soporte → entrada
  ADMIN_DEBIT // Débito manual de soporte → salida
  /// Monetización ráfaga 3 — bump gratis consumido de la cuota mensual Pro.
  /// SIEMPRE amount=0: es un marcador contable para el COUNT de la cuota
  /// (mismo rol que Entitlement.origin=PRO_QUOTA para destacados), NO un
  /// movimiento de bumpBalance. Si llevara amount=-1 rompería el invariante
  /// wallet.bumpBalance == SUM(BumpLedger.amount).
  PRO_QUOTA
  /// Monetización ráfaga 4 — bumps base de un BumpPack comprado por Redsys →
  /// entrada. Congelado en Transaction.baseBumpAmount en el checkout; el
  /// processor nunca relee BumpPack.bumpAmount en vivo.
  PACK_PURCHASE
  /// Monetización ráfaga 4 — bumps extra de bonus Pro al comprar un BumpPack
  /// → entrada, fila SEPARADA de PACK_PURCHASE (mismo criterio que
  /// CreditLedgerType.PRO_BONUS: permite reportar "cuánto regala el bonus
  /// Pro" como métrica de negocio). Congelado en Transaction.bonusBumpAmount.
  PRO_BONUS
  /// Campaña #10 — bumps extra de una campaña BUMP_BONUS al comprar un
  /// BumpPack → entrada, fila SEPARADA de PACK_PURCHASE/PRO_BONUS (espejo de
  /// CreditLedgerType.CAMPAIGN_BONUS). Congelado en
  /// Transaction.campaignBonusBumpAmount.
  CAMPAIGN_BONUS
}

/// Tipo de campaña promocional (H8 Bloque D). Extensible sin migración de datos:
/// los parámetros concretos de cada tipo viven en Campaign.params (jsonb), no en
/// columnas propias. Futuro: COUPON (cupón canjeable, fase 3), BANNER (difusión, fase 4).
enum CampaignType {
  CREDIT_BONUS // Bonus de créditos al comprar un pack
  ACTION_DISCOUNT // Descuento % sobre el coste en créditos de bump/destacar (fase 2)
  BUMP_BONUS // Campaña #10 — bonus de bumps al comprar un BumpPack, espejo de CREDIT_BONUS (moneda distinta)
}

// ============================================================================
//  ENUMS DE FACTURACIÓN FISCAL (emisión de facturas — RF.13)
// ============================================================================
// Capa SEPARADA de la de cobros. La EMISIÓN conforme (número correlativo,
// VeriFactu, PDF válido) la aporta un proveedor homologado externo tras la
// interfaz InvoicingProvider; estos enums modelan solo lo que guardamos NOSOTROS.
// El sistema NO afirma conformidad fiscal por sí mismo. Ver diseno-facturacion.md §13.

/// Tipo fiscal del receptor de una factura. El conjunto exacto que exige una
/// factura española lo valida Ernest con su asesor; esto es la estructura.
enum FiscalEntityType {
  INDIVIDUAL // Particular
  SELF_EMPLOYED // Autónomo
  COMPANY // Empresa / persona jurídica
}

/// Tipo de factura. Una rectificativa NO edita la original (inmutable): es una
/// factura nueva que la referencia (Invoice.rectifiesInvoiceId).
enum InvoiceType {
  ORDINARY // Factura ordinaria
  RECTIFICATIVE // Factura rectificativa (corrige una anterior)
}

/// Estado de una factura. DRAFT → ISSUED es un latch de un solo sentido: una vez
/// ISSUED la factura es INMUTABLE (sin update de número/importe/datos). FAILED =
/// la emisión vía proveedor no pudo completarse; reintentable sin duplicar.
enum InvoiceStatus {
  DRAFT
  ISSUED
  FAILED
}

/// Origen de la emisión. AUTO_PERIODIC = cron de cierre de periodo (periodicidad
/// CONFIGURABLE vía Setting, NO fija en trimestral — la decide el asesor);
/// USER_REQUESTED = emisión manual del usuario dentro de la ventana; ADMIN =
/// emisión/rectificación desde el backoffice.
enum InvoiceOrigin {
  AUTO_PERIODIC
  USER_REQUESTED
  ADMIN
}

/// Motivo de una denuncia, para la cola de moderación.
enum ReportReason {
  SPAM
  FRAUD
  INAPPROPRIATE
  PROHIBITED_ITEM
  WRONG_CATEGORY
  FAKE_REVIEW
  OTHER
}

/// Estado de gestión de una denuncia.
enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  DISMISSED
}

// ============================================================================
//  USUARIOS
// ============================================================================

model User {
  id                  String     @id @default(cuid())
  email               String     @unique
  /// Null para usuarios que solo entran vía login social (Google, etc.)
  passwordHash        String?
  name                String
  /// Slug único para la URL del perfil público (SEO): /vendedor/{slug}
  slug                String     @unique
  phone               String?
  avatarUrl           String?
  bio                 String?    @db.Text
  role                Role       @default(USER)
  status              UserStatus @default(ACTIVE)
  emailVerified       Boolean    @default(false)
  /// Contador de intentos de login fallidos consecutivos; se resetea en login correcto (RÁFAGA 3).
  failedLoginAttempts Int        @default(0)
  /// Si está en el futuro, login() rechaza sin comprobar la contraseña (RÁFAGA 3).
  lockedUntil         DateTime?
  /// Se incrementa en resetPassword()/changePassword()/setPassword(); el JWT lleva su propio
  /// tokenVersion y JwtStrategy lo compara contra este — un cambio invalida TODOS los tokens
  /// previos al instante, sin esperar a que caduquen (RÁFAGA 3).
  tokenVersion        Int        @default(0)
  /// H8 Bloque E — "Vendedor de confianza": confianza otorgada por la plataforma (ADMIN-only).
  /// Independiente de Pro (isProActive): un usuario puede ser Pro, de confianza, ambos o ninguno.
  trusted             Boolean    @default(false)
  /// MODERACIÓN PREVIA (M4) — los anuncios de este vendedor pasan por revisión
  /// antes de publicarse. Es el tercer nivel del disparador, y el MÁS ESPECÍFICO:
  /// ninguna confianza lo afloja.
  ///
  /// ES LO CONTRARIO DE `trusted`, no su ausencia: un usuario puede ser de
  /// confianza y estar marcado a la vez (la marca gana), o no ser ninguna de las
  /// dos cosas, que es el caso normal. Aditivo: nace `false` para todos.
  requiresReview      Boolean    @default(false)

  // Ubicación para mostrar y prefiltrar
  city       String?
  province   String?
  postalCode String?

  /// Referencia al Customer de Stripe; null hasta el primer pago
  stripeCustomerId String? @unique

  // --- Datos fiscales (receptor de facturas — RF.13). Editables por el usuario;
  // se CONGELAN (copia, no referencia) en cada Invoice al emitir: si el usuario
  // cambia su NIF después, la factura ya emitida conserva el de su momento.
  // Bloque SEPARADO de city/province/postalCode (esos son ubicación pública). El
  // conjunto mínimo exacto que exige una factura española lo valida el asesor.
  fiscalTaxId      String? // NIF / DNI / CIF
  fiscalName       String? // Razón social o nombre y apellidos fiscales
  fiscalEntityType FiscalEntityType?
  fiscalAddress    String? // Vía y número
  fiscalCity       String?
  fiscalPostalCode String?
  fiscalProvince   String?
  fiscalCountry    String?           @default("ES")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// ÚLTIMA IP (5a) — el último inicio de sesión, y desde dónde.
  ///
  /// SE PERSISTE Y NO SE DERIVA, y no es una preferencia: **el login no escribe ni una
  /// fila de `AuditLog`** (cero apariciones en `auth.service.ts`), así que no hay nada de
  /// donde derivarlo. La IP que el login recibe se usaba sólo para el rate limit y se
  /// tiraba. Y aunque existiera el registro, ordenar N usuarios por su último inicio
  /// sobre una tabla de eventos exige un `MAX()` por usuario que no se indexa como se
  /// indexa una columna — y ordenar es la mitad de este punto.
  ///
  /// Lo escriben los TRES caminos de login (correo, panel y Google), y **fail-open**: si
  /// anotarlo falla, se entra igual. Es el camino más caliente de la aplicación.
  ///
  /// Sólo la ÚLTIMA, nunca un historial: es la versión mínima que responde la pregunta
  /// antifraude y la que menos se parece a un registro de movimientos.
  ///
  /// Privacidad: dato personal, visible a MODERATOR+ por decisión escrita. NO cubre
  /// `AuditLog.ip`, que es la IP del STAFF y es otro sujeto. Ver
  /// `docs/diseno-ultima-ip.md` §3 y §6.
  lastLoginAt DateTime?
  lastLoginIp String?

  // --- Relaciones ---
  listings            Listing[]
  favorites           Favorite[]
  buyerConvos         Conversation[]       @relation("BuyerConversations")
  sellerConvos        Conversation[]       @relation("SellerConversations")
  messages            Message[]
  reviewsAuthored     Review[]             @relation("ReviewAuthor")
  /// 7b — las valoraciones que este miembro del staff ha retirado.
  reviewsRetired      Review[]             @relation("ReviewRetiredBy")
  reviewsReceived     Review[]             @relation("ReviewTarget")
  dealsAsSeller       Deal[]               @relation("DealSeller")
  dealsAsBuyer        Deal[]               @relation("DealBuyer")
  reportsMade         Report[]             @relation("Reporter")
  reportsReceived     Report[]             @relation("ReportedUser")
  reportsResolved     Report[]             @relation("ReportResolver")
  verificationTokens  VerificationToken[]
  passwordResetTokens PasswordResetToken[]
  accounts            Account[]
  uploadedImages      ListingImage[]       @relation("UploadedImages")
  auditLogsActed      AuditLog[]           @relation("AuditLogActor")
  posts               Post[]               @relation("PostAuthor")
  entitlements        Entitlement[]
  subscriptions       Subscription[]
  transactions        Transaction[]
  wallet              Wallet?
  couponRedemptions   CouponRedemption[]
  notifications       Notification[]
  alerts              Alert[]
  contactReplies      ContactReply[]       @relation("ContactReplyAdmin")
  invoices            Invoice[]
  /// Bump automático — las programaciones de este usuario (tope por usuario, D3).
  bumpSchedules       BumpSchedule[]

  // Atención al usuario R1 — cinco papeles distintos sobre el mismo hilo, cada uno
  // con su @relation nombrada: el usuario DUEÑO del ticket (owner-scope), quien lo
  // abrió (puede ser staff en los flujos b/c), el agente asignado, quien lo cerró y
  // el autor de cada mensaje. Ver diseno-atencion-usuario.md §6.2.
  tickets         Ticket[]        @relation("TicketUser")
  ticketsOpened   Ticket[]        @relation("TicketOpener")
  ticketsAssigned Ticket[]        @relation("TicketAssignee")
  ticketsClosed   Ticket[]        @relation("TicketCloser")
  ticketMessages  TicketMessage[] @relation("TicketMessageAuthor")

  @@index([status])
}

/// Vincula un User con una identidad de proveedor externo (login social).
/// Un User puede tener varias (Google, y en el futuro Facebook/Apple).
model Account {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 'google'; futuro: 'facebook', 'apple'
  provider          String
  /// Identificador estable del usuario en el proveedor (p. ej. el `sub` de Google)
  providerAccountId String
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// ============================================================================
//  CATEGORÍAS (árbol jerárquico autorreferenciado)
// ============================================================================

model Category {
  id      String  @id @default(cuid())
  name    String
  /// Slug único para la URL de listado (SEO): /{slug}
  slug    String  @unique
  iconUrl String?
  order   Int     @default(0)

  // Auto-relación: una categoría puede tener una categoría padre y subcategorías.
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  /// Definición de los atributos esperados para esta categoría (nombre, tipo,
  /// opciones, si es filtrable…). El frontend la usa para pintar el formulario
  /// de publicación y los filtros; los valores concretos viven en Listing.attributes.
  attributeSchema Json @default("[]")

  /// Qué tipo(s) de Listing admite esta categoría. @default(BOTH) preserva el
  /// comportamiento actual (cualquier categoría admite cualquier tipo) para
  /// todas las categorías existentes — sin backfill, Prisma escribe el default
  /// en las filas ya existentes al aplicar la migración.
  allowedListingType ListingTypePolicy @default(BOTH)

  /// MODERACIÓN PREVIA (M1) — los anuncios de esta categoría pasan por revisión
  /// antes de publicarse.
  ///
  /// SE HEREDA HACIA ABAJO Y NO SE PUEDE AFLOJAR: si CUALQUIER ancestro lo tiene
  /// a true, todos sus descendientes lo tienen, y un descendiente con `false` NO
  /// lo anula. Es un pliegue MONÓTONO (un OR sobre la cadena raíz→hoja), a
  /// diferencia de `allowedViews`/`allowedPriceUnits`, que son override. El
  /// porqué es la asimetría del error: equivocarse marcando de más cuesta revisar
  /// trabajo que no hacía falta —y se ve, porque la cola crece—; equivocarse
  /// aflojando cuesta publicar sin revisar, y eso no lo ve nadie.
  ///
  /// Aditivo: nace `false` en todas, así que al aplicar la migración no cambia
  /// nada. Ver `resolveEffectiveRequiresReview` en category.types.ts.
  requiresReview Boolean @default(false)

  /// Vistas de resultados que esta categoría permite ofrecer al usuario en
  /// /[categoria] (RÁFAGA 2). [] = "no configurado" — hereda del padre, o si
  /// tampoco el padre configura nada, cae al default global (las 3, con LISTA
  /// por defecto). Ver `resolveEffectiveViews` en category.types.ts — mismo
  /// criterio de herencia (override completo, no fusión) que allowedListingType.
  allowedViews ListingViewMode[] @default([])

  /// Vista por defecto al entrar en la categoría. Debe estar en `allowedViews`
  /// cuando esta tiene elementos (validado en admin.service.ts al escribir).
  /// null = "no configurado", mismo criterio de herencia que allowedViews.
  defaultView ListingViewMode?

  /// Formatos de precio seleccionables en esta categoría (RP.1). [] = "no
  /// configurado" — hereda del padre; si el padre tampoco configura nada, cae
  /// al default global DEFAULT_ALLOWED_PRICE_UNITS = [ONE_TIME], que reproduce
  /// exactamente el comportamiento anterior a esta ráfaga. Override COMPLETO,
  /// no fusión — mismo criterio de herencia que allowedViews (ver
  /// `resolveEffectivePriceUnits` en category.types.ts), y no el de
  /// allowedListingType: aquí el hijo no está obligado a restringir dentro del
  /// padre (Inmobiliaria [ONE_TIME] → Alquiler [PER_MONTH] es legítimo).
  allowedPriceUnits PriceUnit[] @default([])

  listings     Listing[]
  sponsoredAds SponsoredAd[]
  /// B1 — tags que esta categoría OFRECE. La herencia padre→hija NO se materializa
  /// aquí: se resuelve en lectura (resolveEffectiveTags). Ver model CategoryTag.
  tags         CategoryTag[]

  @@index([parentId])
}

// ============================================================================
//  TAGS (B1) — vocabulario controlado, HERMANO del sistema de atributos
// ============================================================================

/// Etiqueta de vocabulario controlado. Sistema HERMANO del de atributos, NO fusionado
/// con él: un atributo es clave→valor y vive en `Listing.attributes` (jsonb); un tag es
/// pertenece/no-pertenece y vive en una tabla puente.
///
/// POR QUÉ TABLAS Y NO UN `Category.tagSchema Json` calcando el molde de atributos:
///  1. Es vocabulario COMPARTIDO. "Envío incluido" es el mismo concepto en 30 categorías;
///     en Json habría 30 copias y renombrarlo sería reescribir 30 filas.
///  2. Se consulta TRANSVERSALMENTE: el buscador de portada (B4) sugiere sobre todo el
///     vocabulario, con o sin categoría. Con Json habría que cargar y aplanar el árbol
///     entero en cada sugerencia.
///  3. `ListingTag` da INTEGRIDAD REFERENCIAL: no puede existir un anuncio con un tag
///     inexistente. El bag Json de atributos no la tiene — por eso existe
///     `validateAttributeValues`.
/// Lo que SÍ se calca del molde de atributos es lo que importa: config por categoría,
/// herencia padre→hija resuelta en lectura, y CRUD de admin.
///
/// SIN DELETE DURO, solo desactivación — molde ContactReason/Banner/SponsoredAd:
/// desactivar un tag deja de ofrecerlo y de filtrarlo, pero los anuncios que ya lo
/// llevan conservan su fila de ListingTag intacta.
model Tag {
  id String @id @default(cuid())

  /// Lo que viaja en la URL (?tags=cambio-automatico) y lo que se indexará en
  /// Meilisearch (B3). INMUTABLE una vez creado: cambiarlo obligaría a redirigir las
  /// URLs de filtro y a reindexar todos los anuncios que lo llevan. Se renombra `name`.
  slug String @unique

  /// Lo que ve el usuario. Sí es editable.
  name String

  orden  Int     @default(0)
  activo Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories CategoryTag[]
  listings   ListingTag[]

  @@index([activo, orden])
}

/// Qué tags se OFRECEN en qué categoría.
///
/// La herencia padre→hija se resuelve EN LECTURA (`resolveEffectiveTags`), NO se
/// materializa aquí: una hija nunca lleva filas duplicadas de lo que ya ofrece su padre
/// — mismo criterio que `resolveEffectiveSchema` con `attributeSchema`. Materializarla
/// obligaría a propagar cada cambio del padre a todas las hijas, y a mantenerlas en
/// sincronía para siempre.
model CategoryTag {
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  tagId      String
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  /// Orden de oferta dentro de la categoría (el wizard y el panel los muestran así).
  orden Int @default(0)

  @@id([categoryId, tagId])
  @@index([tagId])
}

/// Qué tags TIENE un anuncio concreto. El tope por anuncio es el Setting
/// `maxTagsPerListing`, que se valida al escribir (B2).
model ListingTag {
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  tagId     String
  /// Restrict y no Cascade: borrar un Tag que anuncios están usando no puede llevárselos
  /// por delante en silencio. Hoy no hay DELETE de Tag (solo desactivación), así que
  /// esto es defensa estructural: si algún día se añadiera, la base lo impediría.
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@id([listingId, tagId])
  @@index([tagId])
}

// ============================================================================
//  ANUNCIOS (núcleo del dominio)
// ============================================================================

model Listing {
  id          String @id @default(cuid())
  title       String
  /// Slug único para la ficha (SEO): /anuncio/{slug}
  slug        String @unique
  description String @db.Text

  // Decimal (no Float) para evitar errores de redondeo en importes monetarios.
  price    Decimal @db.Decimal(12, 2)
  currency String  @default("EUR")

  type      ListingType
  condition Condition? // Nulo en servicios
  priceType PriceType     @default(FIXED)
  /// Formato del precio (RP.1). Eje independiente de priceType — ver PriceUnit.
  /// @default(ONE_TIME) preserva el comportamiento actual (todo anuncio era, de
  /// facto, pago único) para todas las filas existentes: Prisma escribe el
  /// default al aplicar la migración, sin backfill. Debe estar entre los
  /// formatos efectivos de su categoría (validado en listings.service, 422).
  priceUnit PriceUnit     @default(ONE_TIME)
  status    ListingStatus @default(DRAFT)

  /// jsonb con los atributos variables según la categoría.
  /// Coche → { km, año, combustible, cambio }; Inmueble → { m2, habitaciones, planta }…
  /// Evita una tabla de columnas distintas por categoría. La búsqueda y el filtrado
  /// fino de estos campos se delegan en Meilisearch.
  attributes Json @default("{}")

  // --- Ubicación ---
  city       String?
  province   String?
  postalCode String?
  latitude   Float?
  longitude  Float?

  /// Teléfono PUBLICADO de este anuncio — opcional, distinto de User.phone (que es
  /// privado). Sugerido desde el perfil al crear, pero el usuario decide explícitamente
  /// si lo publica. Nunca viaja en el payload público de la ficha (ver findBySlug) —
  /// solo se sirve tras autenticación en GET /listings/:id/phone.
  phone String?

  /// FILTRO DEL BACKOFFICE — el MISMO teléfono, en su forma canónica (nueve dígitos, sin
  /// prefijo ni separadores). Derivado de `phone`, nunca escrito a mano.
  ///
  /// EXISTE PORQUE `phone` GUARDA LO QUE TECLEÓ EL VENDEDOR: «654 123 456», «+34
  /// 654-12-34-56», «654123456». Buscar por teléfono contra esa columna falla en cuanto los
  /// formatos no coinciden, y no se puede normalizar en SQL sin una columna donde ponerlo.
  ///
  /// **`phone` NO SE TOCA, y ésa es la decisión**: es lo que se le enseña al comprador. Si
  /// se normalizara en su sitio, el vendedor escribiría su número con espacios y se le
  /// pintaría pegado — se perdería un dato de presentación para ganar uno de búsqueda. Una
  /// columna derivada cuesta menos que eso.
  ///
  /// `null` cuando no hay teléfono O cuando lo que hay no es un teléfono español válido:
  /// canonizar a medias haría casar cosas que no son el mismo número. La regla vive en
  /// `detection/phone-format.ts`, junto al patrón que lo reconoce en texto.
  phoneNormalized String?
  // NOTA PostGIS: para búsquedas por radio eficientes ("anuncios a 10 km") se
  // añade en una migración SQL una columna geography(Point, 4326) con índice GiST,
  // poblada desde latitude/longitude. Prisma la trata como campo no gestionado.

  viewCount Int @default(0)

  // --- Vídeo Pro (proyecto 3) ---
  //
  // CAMPOS EN Listing Y NO UNA TABLA APARTE: es UN vídeo por anuncio (decisión confirmada),
  // así que una tabla sería una relación de más. `ListingImage` no servía: no tiene duración
  // ni póster, y su ciclo de vida es otro (varias por anuncio, con orden).
  //
  // `hasVideo` NO es una columna: se deriva de `videoUrl != null`. Guardar el booleano
  // aparte crearía dos verdades que pueden desincronizarse — y es justamente el booleano
  // (nunca la URL) lo que viajará a las tarjetas de las listas.
  /// URL en nuestro propio almacenamiento. Validada con `isOwnStorageUrl` al guardarse,
  /// porque un `<video src>` no pasa por `remotePatterns` de next/image.
  videoUrl             String?
  /// Frame de portada, capturado por el cliente al subir. Sin él, el reproductor sería un
  /// rectángulo negro; si faltara, la ficha cae a la foto de portada del anuncio.
  videoPosterUrl       String?
  /// Duración DECLARADA por el cliente, en segundos. Ver la frontera anotada en
  /// `video-limits.ts`: el tamaño es infranqueable, la duración es un límite de producto.
  videoDurationSeconds Int?
  /// Cuándo se confirmó la subida. Informativo y útil para moderación.
  videoUploadedAt      DateTime?

  /// ETIQUETA INTERNA (P1, ráfaga E1) — EL TRIAJE DEL STAFF.
  ///
  /// EJE INDEPENDIENTE DE `status`, igual que `needsRevalidation` — y aquí la
  /// separación es el diseño entero, no un detalle. `status` dice qué le pasa al
  /// anuncio (lo ve el mundo); esto dice cómo lo lleva el staff. Un anuncio puede
  /// estar ACTIVE y EDITED, o PENDING_REVIEW y NEW: son preguntas distintas y hay
  /// que poder responder a las dos a la vez. La etiqueta NUNCA gobierna `status`
  /// ni al revés.
  ///
  /// SE LLAMA `triage` Y NO `reviewState` a propósito: cualquier cosa llamada
  /// «review» acabaría confundida con `PENDING_REVIEW`, que es justo el eje del
  /// que hay que mantenerla separada.
  ///
  /// NACE `NEW` POR DEFECTO, SIN CÓDIGO. `create()` tampoco escribe `status`: se
  /// apoya en su `@default(DRAFT)`. Y el default da el valor correcto a todas las
  /// filas existentes sin backfill — nadie ha triado nada todavía.
  triage ListingTriage @default(NEW)

  /// ETIQUETA INTERNA (P1) — «el staff vigila este anuncio».
  ///
  /// ORTOGONAL AL TRIAJE, no un valor suyo: se puede estar REVIEWED y en
  /// observación a la vez, o NEW y en observación. Meterlo dentro del enum
  /// obligaría a valores combinados (REVIEWED_WATCHED, NEW_WATCHED…) y los
  /// valores se multiplicarían en vez de sumarse — la señal clásica de dos ejes
  /// metidos en uno. Mismo reparto que `status` vs `needsRevalidation`.
  watched Boolean @default(false)

  /// PUERTA DE VALIDACIÓN (ráfaga 2) — «este anuncio dejó de cumplir la
  /// configuración de su categoría». Lo pone un cambio de `attributeSchema` que
  /// invalida anuncios ya publicados; lo quita la puerta en cuanto el anuncio
  /// vuelve a cumplir.
  ///
  /// MARCA, NO EXPULSA: el anuncio sigue ACTIVE, sigue en el índice y sigue
  /// siendo editable — el flag no entra en `ListingDocument` ni dispara
  /// reindexado. Es información para el vendedor y una señal para la puerta, no
  /// un estado del ciclo de vida (ése es `status`, y son ejes ortogonales).
  ///
  /// Aditivo: nace `false` para todo lo existente, sin backfill. El índice está
  /// para poder listar los marcados sin recorrer la tabla.
  needsRevalidation Boolean @default(false)

  publishedAt DateTime?
  expiresAt   DateTime?
  bumpedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  /// ÚLTIMA IP (5a) — la última vez que EL DUEÑO gestionó este anuncio, y desde dónde.
  ///
  /// «Gestionar» es actuar sobre él: crear, editar, publicar, reservar, pausar,
  /// reactivar, archivar, renovar, subir (bump) y cerrar o deshacer un trato. **VER NO
  /// CUENTA** —abrir la ficha, mirar las estadísticas o pedir un teléfono no son gestión—
  /// y **el STAFF tampoco**: si un moderador editara y esto se moviera, el dato diría «el
  /// vendedor estuvo aquí» cuando quien estuvo fue el moderador. Peor que no tenerlo.
  ///
  /// POR QUÉ NO SIRVE `updatedAt`, que era la tentación evidente: lo mueve CUALQUIER
  /// escritura de la fila, y hoy lo mueven la edición de staff (P3a/2a/2b), el cambio de
  /// estado de staff, la etiqueta interna, el borrado de `needsRevalidation` y la
  /// transición automática REVIEWED→EDITED. Responde «¿cuándo cambió esta fila?»; esto
  /// responde «¿cuándo actuó su dueño?».
  ///
  /// Nace NULL y no hay backfill: el dato no existía. Se escribe desde
  /// `ListingsController` —el controlador del dueño— y por eso el cron del bump
  /// automático, que no pasa por ningún controlador, no puede tocarlo.
  ///
  /// Privacidad: dato personal, visible a MODERATOR+ por decisión escrita. Ver
  /// `docs/diseno-ultima-ip.md` §6.
  lastOwnerInteractionAt DateTime?
  lastOwnerIp            String?

  // --- Relaciones ---
  sellerId   String
  seller     User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  images        ListingImage[]
  favorites     Favorite[]
  conversations Conversation[]
  deals         Deal[]
  reports       Report[]
  reviews       Review[]
  entitlements  Entitlement[]
  transactions  Transaction[]
  viewsDaily    ListingViewDaily[]
  alertMatches  AlertMatch[]
  tickets       Ticket[]
  /// B1 — tags que este anuncio TIENE. Un anuncio sin tags simplemente no tiene filas.
  tags          ListingTag[]
  /// Bump automático — a lo sumo UNA programación por anuncio (@@unique en BumpSchedule).
  bumpSchedule  BumpSchedule?
  /// PUNTO 6 · RÁFAGA A — lo que el motor encontró en el texto de este anuncio.
  /// El EJE PROPIO del aviso: no es `triage` ni `watched`. Ver `ListingDetection`.
  detections    ListingDetection[]

  // Índices para los filtros y ordenaciones más frecuentes (rendimiento de listados).
  @@index([categoryId, status])
  @@index([status, publishedAt])
  @@index([sellerId])
  @@index([price])
  @@index([province, city])
  /// Puerta ráfaga 2 — para listar los marcados sin recorrer la tabla entera.
  @@index([needsRevalidation])

  /// ETIQUETA INTERNA (P1) — para listar los vigilados sin recorrer la tabla
  /// entera. Mismo criterio y misma forma que `needsRevalidation`: un booleano
  /// cuyo `true` es raro, con una consulta propia detrás («enséñame lo que
  /// estamos vigilando»).
  ///
  /// `triage` NO lleva índice todavía a propósito: son tres valores repartidos,
  /// y el índice útil sería el compuesto con el orden de la lista. F2 dejó dicho
  /// —y demostrado con EXPLAIN— que eso se mide antes de añadirlo; se decide en
  /// E2, que es donde la consulta existe.
  @@index([watched])

  /// FICHA F2 (P6) — EL ÍNDICE QUE FALTABA, y faltaba en la consulta más caliente
  /// del backoffice: la lista de `/admin/anuncios` ordena por `updatedAt` y no
  /// había NINGÚN índice sobre esa columna. `[status, publishedAt]` sirve para
  /// filtrar por estado, pero no para ordenar por `updatedAt`: Postgres tenía que
  /// ordenar el resultado a mano. Con pocos miles de filas da igual; al crecer, la
  /// primera pantalla que se degrada es la principal.
  ///
  /// Van los DOS porque son dos consultas distintas: con filtro de estado —el
  /// caso de la cola de revisión y de los filtros— manda el compuesto; sin él
  /// —la vista «Todos», que es la de entrada— manda el simple.
  @@index([status, updatedAt])
  @@index([updatedAt])
}

/// PUNTO 6 · RÁFAGA A — qué detector encontró qué.
enum DetectorId {
  /// La lista de palabras prohibidas. Bloquea desde siempre.
  WORD

  /// Teléfono español en el texto. Avisa: es anti-EVASIÓN del campo `Listing.phone`.
  PHONE

  /// A2 — un teléfono de la lista de marcados (`Setting['flaggedPhones']`).
  ///
  /// CONVIVE con `PHONE` y no lo sustituye, porque responden preguntas distintas:
  ///   · `PHONE`      — «hay un teléfono FUERA de su sitio». Evasión de la puerta de
  ///                    `GET /listings/:id/phone`. Heurística: dispara con cualquiera.
  ///   · `PHONE_LIST` — «ESTE número está marcado». Reincidencia. Su criterio no es una
  ///                    heurística: es una lista que alguien escribió a mano.
  ///
  /// Comparten el reconocedor (`detection/phone-format.ts`); lo único que cambia es el
  /// criterio de disparo — y los campos que miran (ver `DetectionField.PHONE`).
  PHONE_LIST

  /// A1 — AQUÍ ESTUVO `IP`, y se retiró.
  ///
  /// Buscaba IPv4 en el título y la descripción. Se quitó porque **no respondía a ninguna
  /// pregunta que alguien hiciera**: una IP en el texto de un anuncio suele ser PRODUCTO
  /// —quien vende un router y documenta su `192.168.1.1`— y no señal. El de teléfonos sí
  /// tiene un caso de uso escrito (esquivar la puerta de `GET /listings/:id/phone`); éste
  /// no tenía equivalente.
  ///
  /// Lo que sí hacía falta —«esta IP concreta es fraudulenta»— no se mira en el texto sino
  /// en `User.lastLoginIp` / `Listing.lastOwnerIp`, y **no necesita detector ni tabla**: es
  /// `columna IN (lista)`, derivado en cada lectura. Ver `Setting['flaggedIps']`.
  ///
  /// Se decidió SIN DATOS, a propósito: el banco de pruebas nunca llegó a medirlo, y medir
  /// algo que no responde a ninguna pregunta no habría cambiado la decisión. Es lo único
  /// irreversible de A1. Ver `docs/diseno-listas-ip-telefono.md` §A.2.
}

/// En qué campo del anuncio apareció.
enum DetectionField {
  TITLE
  DESCRIPTION

  /// A2 — el campo `Listing.phone`, el sitio LEGÍTIMO del teléfono.
  ///
  /// **Sólo lo mira `PHONE_LIST`, y la asimetría es deliberada**: un número marcado lo está
  /// esté donde esté, mientras que `PHONE` persigue EVASIÓN — y un teléfono en su propio
  /// campo, servido tras `JwtAuthGuard`, no esquiva nada. Si `PHONE` lo mirara, avisaría de
  /// que el vendedor usó el canal correcto.
  PHONE
}

/// PUNTO 6 · RÁFAGA A — UN HALLAZGO DEL MOTOR DE DETECCIÓN.
///
/// ES EL EJE PROPIO DEL AVISO, y por eso es una tabla y no una columna en `Listing`:
///
///   · NO es `watched`. Ése significa «el staff decidió vigilar esto», se pone a mano y se
///     audita con nombre. Si el sistema lo escribiera, un moderador que quite la vigilancia
///     se la encontraría puesta otra vez en la siguiente edición — y además no hay a quién
///     apuntarle el cambio: `AuditLog.actorId` es NOT NULL con FK a `User`, que es la misma
///     razón por la que la transición automática de P1 no se audita.
///   · NO es `triage`. Ése responde «¿alguien del staff lo ha mirado?». Que una expresión
///     regular encuentre un teléfono no es haberlo mirado, ni es que el dueño lo haya
///     editado. Meterlo ahí obligaría a un cuarto valor excluyente, y entonces un anuncio
///     `REVIEWED` que dispara un detector dejaría de ser `REVIEWED`: el juicio de una
///     persona destruido por un hallazgo automático.
///
/// Son TRES preguntas compatibles —«¿lo han mirado?», «¿lo vigilamos?», «¿qué encontró el
/// sistema?»— y hacen falta las tres a la vez. Un anuncio puede ser `REVIEWED`, no vigilado
/// y tener una detección de teléfono: significa que un humano lo dio por bueno SABIENDO que
/// hay un teléfono. Ver `docs/diseno-listas-bloqueo.md` §3.
///
/// ─── POR QUÉ PERSISTIDA, SI F1 DERIVA SU SEÑAL AL VUELO ─────────────────────────────
///
/// La ficha calcula `palabraProhibida` en cada lectura y no la guarda, que es honesto y
/// nunca se queda obsoleto. Pero **no es listable**: la pregunta que hace útil el modo
/// avisar es «enséñame TODO lo que tiene una detección», y responderla al vuelo obliga a
/// recorrer la tabla de anuncios entera ejecutando los detectores fila a fila. Un aviso que
/// no se puede listar es un aviso que nadie lee.
///
/// ─── Y POR QUÉ NO SE QUEDA OBSOLETA ─────────────────────────────────────────────────
///
/// **Se reemplazan ENTERAS en cada pasada**: borrar las de ese anuncio e insertar las del
/// texto actual. Molde del reemplazo completo de tags de B2. Nunca hay detecciones viejas:
/// siempre son el producto de la última pasada sobre el texto que hay ahora. El dueño quita
/// el teléfono y la detección desaparece sola, sin que nadie tenga que acordarse — que es
/// como se pudren los flags puestos a mano.
///
/// ─── `Cascade`, Y POR QUÉ NO CONTRADICE A B1 ────────────────────────────────────────
///
/// B1 protegió `Report`, `Conversation` y `Review` del borrado del anuncio porque describen
/// HECHOS ENTRE PERSONAS y tienen valor propio. Una detección no: es un DERIVADO del texto,
/// recalculable, sin significado fuera de él. Muerto el anuncio, no dice nada.
///
/// ─── EL DATO PERSONAL, DICHO A LA CARA ──────────────────────────────────────────────
///
/// Una detección de teléfono guarda un teléfono. Se hace, y por tres razones:
///   1. NO es una divulgación nueva: ese número está en la DESCRIPCIÓN PÚBLICA del anuncio,
///      legible sin identificarse — que es justamente el problema que el detector señala.
///      Esto es un índice a texto ya público, no un secreto extraído.
///   2. Sin el fragmento no se puede juzgar, y juzgar es todo el propósito del modo avisar.
///   3. Muere con el anuncio (`Cascade`) y se reemplaza en cada edición: no sobrevive al
///      texto del que salió.
/// Acceso MODERATOR+, heredado del segmento donde se enseña. Misma decisión consciente que
/// 5a tomó con la IP, anotada igual.
model ListingDetection {
  id String @id @default(cuid())

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  detector DetectorId
  field    DetectionField

  /// El fragmento encontrado. Para `WORD`, el token normalizado que casó.
  match String

  /// Qué regla casó: la entrada de la lista para `WORD`; `null` en los de patrón, donde el
  /// propio `detector` ya lo dice todo.
  rule String?

  createdAt DateTime @default(now())

  /// El filtro «enséñame lo que tiene avisos» de `/admin/anuncios` se resuelve por relación
  /// contra este índice. SIN desnormalizar un booleano en `Listing` todavía: si resulta
  /// caro se mide con EXPLAIN ANALYZE y entonces se decide, que es el criterio con el que
  /// F2 añadió un índice y E2 decidió no añadirlo. Denormalizar antes de medir se inventa
  /// un problema y crea una segunda verdad que mantener.
  @@index([listingId])
  /// Para el filtro por detector — el que convierte la lista en el banco de pruebas.
  @@index([detector])
}

model ListingImage {
  id     String  @id @default(cuid())
  url    String
  alt    String?
  width  Int?
  height Int?
  order  Int     @default(0)

  listingId String?
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: Cascade)

  uploadedById String?
  uploadedBy   User?   @relation("UploadedImages", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([listingId])
  @@index([uploadedById])
}

// ============================================================================
//  FAVORITOS
// ============================================================================

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  // Un usuario no puede marcar el mismo anuncio dos veces.
  @@unique([userId, listingId])
  @@index([userId])
}

/// Notificación in-app. `type` es String (no enum) — igual que AuditLog.action —
/// para poder añadir tipos futuros sin migración.
/// Valores de `type` conocidos: ALERT_MATCH, CONTACT_MESSAGE.
/// CONTACT_MESSAGE es fan-out: una Notification por cada User con role ADMIN, no
/// un buzón compartido — Notification es estrictamente userId 1:1 (ver RC.1).
/// Limitación conocida y aceptada: cuando un admin atiende el mensaje, las
/// notificaciones de los demás admins no se marcan como leídas automáticamente
/// (exigiría consultar dentro de `data`, justo lo que este diseño evita). Ruido
/// tolerable con pocos admins; revisar si el equipo de admins crece mucho.
model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type String

  /// Snapshot autocontenido del evento — NO punteros a otras entidades. La
  /// notificación es un registro histórico que debe poder renderizarse sin
  /// consultas adicionales y sobrevivir aunque el anuncio o la alerta se
  /// borren después. Forma para ALERT_MATCH: { alertId, alertName, listingId,
  /// listingSlug, listingTitle }.
  data Json

  read      Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, read])
}

/// Búsqueda guardada de un comprador. Los criterios core son columnas propias
/// (no un blob Json de SearchParams) para que B3 pueda pre-filtrar alertas
/// candidatas con SQL al publicarse un anuncio, en vez de deserializar todas
/// las alertas activas en memoria. Mismo patrón core+attributes que
/// Listing.attributes / parseSearchQuery. Ver alertToSearchParams() en
/// AlertsService para la conversión de vuelta a SearchParams.
model Alert {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Mostrado en /mis-alertas y snapshoteado en Notification.data.alertName (B1).
  name String

  q            String?
  categorySlug String?
  type         ListingType?
  condition    Condition?
  priceType    PriceType?
  minPrice     Decimal?     @db.Decimal(12, 2)
  maxPrice     Decimal?     @db.Decimal(12, 2)
  province     String?
  city         String?
  /// Atributos dinámicos por categoría, ya coaccionados a su tipo real
  /// (number/boolean/string) al guardar — ver AlertsService. Mismo shape que
  /// SearchParams.attributes.
  attributes   Json?

  // Alternativa/complemento a province/city, igual que SearchParams.geo.
  lat          Float?
  lng          Float?
  radiusMeters Int?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  matches AlertMatch[]

  @@index([userId])
  @@index([active])
}

/// Deduplicación (alerta, anuncio): impide re-notificar el mismo anuncio para
/// la misma alerta (p. ej. tras un renew()), y hace idempotente un reintento
/// del job de matching (create() + catch P2002 = ya notificado, se salta).
/// Tabla propia (no Notification.data Json) por la misma razón que Alert usa
/// columnas: se necesita consultar/insertar por (alertId, listingId) con un
/// índice único, no un blob opaco.
model AlertMatch {
  id        String   @id @default(cuid())
  alertId   String
  alert     Alert    @relation(fields: [alertId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([alertId, listingId])
  @@index([listingId])
}

/// H8 Bloque C1 — agregado diario de vistas de un anuncio (no un evento por
/// vista). El total (free) sigue viviendo en Listing.viewCount; esta tabla
/// solo aporta la granularidad temporal para la gráfica Pro (GROUP BY date).
model ListingViewDaily {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  count     Int      @default(0)

  @@unique([listingId, date])
  @@index([listingId])
}

// ============================================================================
//  MENSAJERÍA (conversación por anuncio entre comprador y vendedor)
// ============================================================================

model Conversation {
  id String @id @default(cuid())

  // BORRADO B1 — nullable + `SetNull`, ANTES obligatorio + `Cascade`.
  //
  // LA CABECERA DE ESTE BLOQUE DICE «conversación POR ANUNCIO», y con `Cascade` era
  // coherente: la conversación era del anuncio y moría con él. El criterio cambia
  // por tres razones, en orden de peso (docs/diseno-borrado.md §2.5):
  //
  //  1. LOS MENSAJES SON DE DOS PERSONAS, no del anuncio. Llevan acuerdos,
  //     direcciones, teléfonos y —cuando algo va mal— la prueba de lo que se dijo.
  //     Que el vendedor pueda destruir el hilo del comprador borrando su propio
  //     anuncio es el MISMO abuso que cerraba el `SetNull` de `Report`, con otro
  //     nombre.
  //  2. HABÍA UNA INCOHERENCIA DENTRO DEL PROPIO MODELO: `Deal.conversationId` es
  //     `SetNull` y distingue «interacción verificable» de «afirmado por el
  //     vendedor». Con `Cascade` aquí, borrar el anuncio ponía ese campo a `null` y
  //     degradaba en silencio la evidencia de un trato que sí ocurrió.
  //  3. `archive()` presume de NO destruir conversaciones. Si `archive → delete`
  //     acababa destruyéndolas igual, la promesa duraba lo que tardara el staff en
  //     pasar por ahí.
  listingId String?
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  /// Snapshot del título, tomado AL CREAR la conversación. Molde
  /// `Review.listingTitle`. Es lo que permite que la bandeja siga siendo legible
  /// cuando el anuncio ya no está: se pinta el título, sin enlace y sin miniatura
  /// (la miniatura no puede sobrevivir — sus objetos de R2 se borran con el anuncio).
  listingTitle String?
  buyerId   String
  buyer     User    @relation("BuyerConversations", fields: [buyerId], references: [id])
  sellerId  String
  seller    User    @relation("SellerConversations", fields: [sellerId], references: [id])

  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  messages Message[]
  deals    Deal[]

  // Una sola conversación por (anuncio, comprador).
  //
  // BORRADO B1 — CON `listingId` NULLABLE ESTA RESTRICCIÓN SE RELAJA, y se acepta a
  // propósito: en Postgres los NULL no colisionan entre sí, así que varias
  // conversaciones huérfanas del mismo par comprador/vendedor pueden coexistir. Es
  // correcto — son hilos históricos de anuncios DISTINTOS, y la unicidad sólo tiene
  // sentido mientras el anuncio existe (que es cuando `startConversation` la
  // consulta, siempre con un id real).
  @@unique([listingId, buyerId])
  @@index([buyerId])
  @@index([sellerId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  body           String       @db.Text
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

// ============================================================================
//  TRATOS (ciclo de vida — RÁFAGA 1: cierre de venta/servicio por tipo)
// ============================================================================

/// Un trato cerrado sobre un anuncio: quién fue el comprador/cliente. No existía
/// ningún registro de esto antes de esta ráfaga (SOLD no llevaba comprador).
/// NO reutiliza `Transaction` (esa es solo facturación de la plataforma — Pro,
/// destacados — nunca dinero entre particulares, que sigue fuera de la app).
/// PRODUCTO genera un único Deal y agota el anuncio (→ SOLD); SERVICIO genera
/// N Deals (uno por cliente) y el anuncio sigue ACTIVE — ver `closeDeal()` en
/// ListingsService.
model Deal {
  id String @id @default(cuid())

  // Nullable + SetNull, mismo molde que Review.listingId: un Deal es evidencia
  // de reputación (RÁFAGA 3 lo consulta en vez de Conversation — ver
  // ReviewsService.getEligibility/create) y no debe desaparecer si el
  // anuncio se borra después. listingTitle conserva el contexto, igual que
  // Review.listingTitle.
  listingId    String?
  listing      Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  listingTitle String

  // Denormalizados — mismo criterio que Conversation.sellerId (derivable de
  // listing.sellerId y aun así guardado aparte): evita joins para "mis tratos
  // como vendedor" y es el shape que RÁFAGA 3 usa para sustituir la
  // búsqueda por Conversation en reviews.service.ts sin cambiar su forma.
  sellerId String
  seller   User   @relation("DealSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  buyerId  String
  buyer    User   @relation("DealBuyer", fields: [buyerId], references: [id], onDelete: Cascade)

  /// Enlazada por el SERVIDOR buscando una Conversation real para
  /// (listingId, buyerId) — NUNCA aceptada del cliente. Null si el trato se
  /// cerró sin conversación previa por la plataforma (comprador elegido por
  /// búsqueda libre: por teléfono, en persona...). Distingue "interacción
  /// verificable" de "afirmado por el vendedor" — relevante para cuando la
  /// ráfaga 2 decida si valorar exige un Deal.
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  // Sin unique constraint: un mismo cliente puede repetir trato con el mismo
  // servicio (a diferencia de Review, que sí es único por [author,target,listing]).
  @@index([listingId])
  @@index([sellerId])
  @@index([buyerId])
  @@index([conversationId])
}

// ============================================================================
//  VALORACIONES (reputación)
// ============================================================================

model Review {
  id      String  @id @default(cuid())
  rating  Int // 1..5 (validado en el DTO)
  comment String? @db.Text

  authorId     String
  author       User     @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  targetId     String
  target       User     @relation("ReviewTarget", fields: [targetId], references: [id], onDelete: Cascade)
  // Nullable: la reseña sobrevive al borrado del anuncio (la reputación no es
  // borrable por el vendedor); listingId pasa a NULL, análogo a
  // Entitlement/Transaction. listingTitle conserva el contexto.
  listingId    String?
  listing      Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  // Snapshot del título del anuncio en el momento de crear la reseña, para que
  // el listado público pueda mostrar contexto aunque el anuncio se borre después.
  listingTitle String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  // null hasta la primera edición; frontend muestra indicador "Editada" cuando no es null
  editedAt  DateTime?

  /// Reputación RÁFAGA 3 — congelado al crear, NUNCA recalculado (ni por
  /// edit(), ni por ningún otro endpoint): true si en ese momento existía
  /// AL MENOS UN Deal verificable (conversationId != null) entre autor y
  /// objetivo sobre este listing. Solo las verified=true cuentan para
  /// average/count/distribution en listForUser(); las no verificadas se
  /// muestran igual en la lista pública, etiquetadas. @default(true) es
  /// grandfathering deliberado: las reseñas creadas antes de esta ráfaga
  /// (bajo el gate viejo de Conversation) cuentan como contaban, sin backfill.
  verified Boolean @default(true)

  /// 7b — RETIRADA POR EL EQUIPO. `null` = vigente.
  ///
  /// RETIRADA LÓGICA Y NO BORRADO, y no es una preferencia de estilo: hasta 7b existía
  /// `DELETE /moderation/reviews/:id`, que borraba la fila **físicamente**. Como
  /// `Report.reviewId` es `Cascade` (ver ese modelo), cada uso destruía **la propia
  /// denuncia que había motivado la retirada** — y el flujo de la cola de denuncias, que
  /// borra y acto seguido resuelve el reporte, acababa con un 404 sobre un reporte que ya
  /// no existía. B1 dejó anotado ese defecto como «riesgo 5, fuera de alcance porque va de
  /// reseñas»: 7b es «va de reseñas».
  ///
  /// Con la fila viva, el `Cascade` no se dispara nunca y la denuncia sobrevive. **Queda
  /// NEUTRALIZADO, no resuelto:** si algún día hace falta supresión real (RGPD), hay que
  /// pasar `Report.reviewId` a `SetNull` ANTES.
  ///
  /// Molde: `Entitlement.revokedAt` — el registro sobrevive y deja de contar. Y
  /// `ContactReason.activo`, que lo dice con palabras: «no hay endpoint DELETE; se
  /// desactiva».
  ///
  /// QUÉ IMPLICA ESTAR RETIRADA: no se ve en el perfil público y NO cuenta para la media
  /// (`average`, `count`, `distribution` ni `getRatingSummaries`). El STAFF sí la ve,
  /// marcada, para poder restaurarla — retirar es reversible, y por eso es MODERATOR y no
  /// ADMIN (criterio B2: ADMIN sólo para lo irreversible).
  ///
  /// Y SIGUE OCUPANDO su `@@unique([authorId, targetId, listingId])`, a propósito: su
  /// autor no puede escribir otra sobre el mismo anuncio. Retirar es «esto no debió
  /// publicarse»; dejar reescribirla invitaría a repetirla.
  retiredAt     DateTime?
  /// Quién la retiró. SetNull: que se borre la cuenta del moderador no puede resucitar
  /// una valoración retirada (molde `Report.resolvedById`).
  retiredById   String?
  retiredBy     User?     @relation("ReviewRetiredBy", fields: [retiredById], references: [id], onDelete: SetNull)
  /// Por qué. Obligatorio en el DTO — molde del `reason` de P3a: sin él, una retirada
  /// sería indistinguible de otra y no habría cómo revisarla.
  retiredReason String?   @db.Text

  reports Report[]
  tickets Ticket[]

  // [authorId, targetId, listingId] permite bidireccionalidad (buyer→seller y
  // seller→buyer son filas distintas) Y limita a una review por par por
  // listing — deliberado (RÁFAGA 3): NO se ancla a un Deal concreto
  // (sin dealId) precisamente para que repetir tratos con el mismo par
  // (Deal no tiene límite de repetición) no multiplique el peso de una
  // review. Ver ReviewsService.getEligibility/create.
  @@unique([authorId, targetId, listingId])
  @@index([targetId])
  /// 7b — molde `Entitlement.@@index([revokedAt])`: los SIETE lectores públicos filtran
  /// por `retiredAt: null`, y una retirada es rara por construcción.
  @@index([retiredAt])
  @@index([listingId])
}

// ============================================================================
//  MODERACIÓN (denuncias)
// ============================================================================

model Report {
  id          String       @id @default(cuid())
  reason      ReportReason
  description String?      @db.Text
  status      ReportStatus @default(PENDING)

  reporterId String
  reporter   User   @relation("Reporter", fields: [reporterId], references: [id])

  // Una denuncia apunta a un anuncio o a un usuario (al menos uno).
  //
  // BORRADO B1 — `SetNull`, ANTES `Cascade`. La denuncia SOBREVIVE al borrado del
  // anuncio, y el cambio no es cosmético: mientras fue `Cascade`, **el denunciado
  // podía destruir la denuncia borrando su propio anuncio** —resuelta o no—, y hoy
  // borrar es precisamente del dueño. Se perdía la evidencia de moderación por la
  // vía más fácil que existe.
  //
  // No era una decisión, era el valor por defecto que nadie revisó: la relación de
  // al lado —`Review.listingId`— sí la tomó, y dice lo contrario con su razón
  // escrita («la reputación no es borrable por el vendedor»). La denuncia merece
  // exactamente el mismo argumento y le había tocado el valor opuesto.
  //
  // Ver docs/diseno-borrado.md §2.4.
  listingId      String?
  listing        Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  /// Snapshot del título del anuncio denunciado, tomado AL CREAR la denuncia.
  /// Molde exacto de `Review.listingTitle` / `Deal.listingTitle` / `Ticket.linkedLabel`.
  /// Sin él, el `SetNull` de arriba dejaría la denuncia sin contexto legible: la cola
  /// de moderación mostraría un reporte de «algo» que ya no se puede nombrar.
  ///
  /// SE ESCRIBE AL CREAR, NO AL BORRAR, y eso es deliberado (diseño §3.3): rellenarlo
  /// en el borrado convertiría un DELETE en una escritura de N filas dentro de la
  /// transacción, y sería un camino que sólo se ejecuta ahí — es decir, que sólo se
  /// prueba ahí.
  listingTitle   String?
  reportedUserId String?
  reportedUser   User?    @relation("ReportedUser", fields: [reportedUserId], references: [id])

  // Auditoría de la resolución por parte de un moderador.
  resolvedById String?
  resolvedBy   User?     @relation("ReportResolver", fields: [resolvedById], references: [id])
  resolvedAt   DateTime?

  // Una denuncia puede apuntar a una valoración (además de a listing o user)
  reviewId String?
  review   Review? @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  /// Atención al usuario R1 — hilos abiertos con el usuario reportado a raíz de esta
  /// denuncia (flujo c). Report NO absorbe la conversación ni cambia por ella: el
  /// ticket referencia al reporte, no al revés. Ver diseno-atencion-usuario.md §8.3.
  tickets Ticket[]

  @@index([status])
  @@index([listingId])
  @@index([reviewId])
}

// ============================================================================
//  AUDITORÍA (backoffice)
// ============================================================================

/// Registro inmutable de cada acción administrativa sensible.
/// DECISIÓN DE DISEÑO: capturado mediante AuditLogService inyectado en el
/// service de dominio, NUNCA con un interceptor de NestJS. El interceptor no
/// tiene acceso al estado de Prisma antes de la mutación (el campo `before`
/// requiere leer el recurso justo antes de modificarlo, dentro del service).
model AuditLog {
  id String @id @default(cuid())

  /// Convención SCREAMING_SNAKE_CASE:
  /// LISTING_DEACTIVATE | LISTING_RESTORE | LISTING_APPROVE | LISTING_REJECT
  /// LISTING_DELETE (borrado B2 — irreversible; su `before` es lo ÚNICO que
  ///   sobrevive al anuncio, así que lleva identidad, dueño y recuentos)
  /// LISTING_TRIAGE_CHANGE (etiqueta interna P1 — la anotación del staff. SÓLO
  ///   los cambios MANUALES: la transición automática REVIEWED→EDITED no genera
  ///   registro porque no lleva ningún dato que el anuncio no tenga ya, y porque
  ///   `actorId` exige una persona)
  /// USER_SUSPEND | USER_BAN | USER_REINSTATE | USER_ROLE_CHANGE
  /// REPORT_RESOLVE | REPORT_DISMISS
  /// CATEGORY_CREATE | CATEGORY_EDIT | CATEGORY_DELETE | CATEGORY_REORDER
  /// SETTING_UPDATE
  /// SPONSORED_AD_CREATE | SPONSORED_AD_EDIT | SPONSORED_AD_ACTIVATE | SPONSORED_AD_DEACTIVATE
  /// CONTACT_MESSAGE_STATUS_CHANGE | CONTACT_MESSAGE_REPLY
  /// CONTACT_REASON_CREATE | CONTACT_REASON_EDIT | CONTACT_REASON_ACTIVATE |
  /// CONTACT_REASON_DEACTIVATE | CONTACT_REASON_REORDER
  /// PRICE_UPDATE | CREDIT_PACK_UPDATE
  /// PRO_GRANT | PRO_REVOKE (ficha de usuario U2 — Pro concedido a mano, sin
  ///   suscripción y con vencimiento obligatorio)
  /// ADMIN_BUMP_GRANT | ADMIN_CREDIT_DEBIT | ADMIN_BUMP_DEBIT (U2 — dar bumps y
  ///   quitar saldo; el `after` lleva lo PEDIDO y lo realmente descontado, para
  ///   que el suelo en cero se vea en vez de esconderse)
  action String

  actorId String
  actor   User   @relation("AuditLogActor", fields: [actorId], references: [id])

  /// "Listing" | "User" | "Report" | "Category" | "Setting"
  resourceType String
  resourceId   String

  /// Snapshot del estado ANTES de la mutación. Null si no aplica (p.ej. primera
  /// escritura de un Setting).
  before Json?

  /// Snapshot del estado DESPUÉS de la mutación.
  after Json?

  /// IP del actor para auditoría de seguridad (extraída del request).
  ip String?

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([resourceType, resourceId])
  @@index([createdAt])
}

// ============================================================================
//  AJUSTES DEL SISTEMA (backoffice)
// ============================================================================

/// Configuración del sistema editable desde el backoffice sin despliegue.
/// Keys conocidas: badWordList (string[]), listingExpiryDays (number),
/// contactRequiresVerification (boolean), fiscalIssuer (datos fiscales del
/// EMISOR de facturas: { taxId, fiscalName, address, city, postalCode, province,
/// country } — RF.13; se congela en cada Invoice al emitir), fiscalSelfServiceWindow
/// (ventana de autoservicio de facturación — RF.13; su valor fiscal lo fija el asesor).
/// Sembradas en seed.ts con createMany + skipDuplicates para no pisar valores
/// que el admin haya cambiado manualmente.
model Setting {
  /// Clave única del ajuste (ej. "badWordList").
  key String @id

  /// Valor serializado como JSON. El tipo concreto depende de la key.
  value Json

  updatedAt DateTime @updatedAt

  /// ID del admin que actualizó el ajuste por última vez (null en seed inicial).
  updatedById String?
}

// ============================================================================
//  AUTH TOKENS (verificación de email y recuperación de contraseña)
// ============================================================================

model VerificationToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ============================================================================
//  FACTURACIÓN
// ============================================================================

/// Producto comercial. Los precios concretos viven en Price.
/// Los productos no se eliminan físicamente; se desactivan (active = false).
model Product {
  id          String      @id @default(cuid())
  name        String
  description String?     @db.Text
  type        ProductType

  /// Cuando active=false, el producto no se ofrece en nuevas compras
  /// pero sus Prices y Entitlements existentes siguen vigentes.
  active Boolean @default(true)

  prices Price[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Variante de precio de un producto. Una variante = una opción de compra.
model Price {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id])

  amount   Decimal @db.Decimal(10, 2)
  currency String  @default("EUR")

  // Solo para RECURRING
  interval      PriceInterval?
  intervalCount Int?           @default(1)

  // Solo para ONE_TIME (destacado)
  durationDays Int?

  /// ID del objeto equivalente en la pasarela (Stripe Price ID).
  gatewayPriceId String? @unique

  /// FK al CreditPack asociado; solo presente en Prices de packs de créditos.
  creditPackId String?     @unique
  creditPack   CreditPack? @relation(fields: [creditPackId], references: [id])

  /// Monetización ráfaga 4 — FK al BumpPack asociado; solo presente en Prices
  /// de packs de bumps directos. Un Price representa un único propósito
  /// (destacado XOR pack de créditos XOR pack de bumps), por convención, no
  /// forzado por constraint — igual que ya era el caso entre durationDays y
  /// creditPackId.
  bumpPackId String?   @unique
  bumpPack   BumpPack? @relation(fields: [bumpPackId], references: [id])

  active Boolean @default(true)

  transactions  Transaction[]
  subscriptions Subscription[]
  entitlements  Entitlement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

/// Registro de un derecho activo. Es la única tabla que lee la lógica de negocio
/// para decidir si un usuario puede hacer algo. No conoce la pasarela.
///
/// Un entitlement es VIGENTE cuando:
///   revokedAt IS NULL AND (expiresAt IS NULL OR expiresAt > now())
///
/// revokedAt se setea en dos casos:
///   1. El cron de expiración procesa un FEATURED_LISTING caducado (B.1) — garantiza
///      que cada destacado expirado se reindexe exactamente una vez.
///   2. Un administrador revoca manualmente un entitlement aún no caducado (futuro).
/// Nunca se borra una fila de esta tabla; la revocación es el mecanismo de cierre.
model Entitlement {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type EntitlementType

  /// Solo para FEATURED_LISTING: de qué bolsa salió (cuota Pro vs. adquirido).
  /// Null para PRO_SUBSCRIPTION. Backfill H8.1: transactionId presente → REDSYS,
  /// ausente → CREDITS (así se distinguían ya antes de existir este campo).
  origin FeaturedOrigin?

  /// Solo para FEATURED_LISTING: anuncio al que aplica el boost.
  listingId String?
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  startsAt  DateTime  @default(now())
  /// Null = sin caducidad (reservado para créditos manuales de soporte).
  expiresAt DateTime?

  /// Seteado cuando el entitlement se revoca explícitamente (cron de expiración de
  /// FEATURED_LISTING, o revocación manual de admin). Un entitlement con revokedAt
  /// seteado NO cuenta como vigente aunque expiresAt sea futuro.
  revokedAt DateTime?

  // Trazabilidad del origen
  priceId        String?
  price          Price?        @relation(fields: [priceId], references: [id])
  transactionId  String?
  transaction    Transaction?  @relation(fields: [transactionId], references: [id])
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

  createdAt DateTime @default(now())

  /// Red de seguridad en BD contra doble concesión: una misma Transaction no
  /// puede generar dos entitlements del mismo tipo (el escenario de un job de
  /// BillingProcessor/RedsysProcessor reintentado tras un commit exitoso pero
  /// un ack fallido — ver deuda "concesión de destacado", H8 Bloque D fase 4).
  /// NULLs no colisionan entre sí (semántica estándar de UNIQUE en Postgres):
  /// esto NO protege los caminos que no llevan transactionId (cuota Pro,
  /// créditos, cupón — sus checks de "ya activo" viven solo en aplicación,
  /// sin lock; ver grantFeaturedListingTx/assertFeaturable).
  @@unique([transactionId, type])
  @@index([userId, type])
  @@index([userId, type, origin, createdAt])
  @@index([listingId])
  @@index([expiresAt])
  @@index([revokedAt])
}

/// Estado de una suscripción recurrente. Una sola suscripción activa por usuario.
model Subscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  priceId String
  price   Price  @relation(fields: [priceId], references: [id])

  status SubscriptionStatus @default(ACTIVE)

  currentPeriodStart DateTime
  currentPeriodEnd   DateTime

  cancelAtPeriodEnd Boolean   @default(false)
  canceledAt        DateTime?

  /// ID de la suscripción en Stripe. Inmutable tras la creación.
  gatewaySubscriptionId String @unique

  entitlements Entitlement[]
  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([currentPeriodEnd])
}

/// Registro permanente de cada cobro. NUNCA se borra ni se modifica el importe.
model Transaction {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  priceId String
  price   Price  @relation(fields: [priceId], references: [id])

  amountGross Decimal @db.Decimal(10, 2)
  amountNet   Decimal @db.Decimal(10, 2)
  taxAmount   Decimal @db.Decimal(10, 2)
  taxRate     Decimal @db.Decimal(5, 4)
  currency    String  @default("EUR")

  status TransactionStatus @default(PENDING)

  /// Pasarela que procesó el cobro. "STRIPE" | "REDSYS"
  gateway String @default("STRIPE")

  /// Referencias de la pasarela. NUNCA se almacenan PANs, CVVs ni datos de tarjeta.
  gatewayPaymentIntentId String? @unique
  gatewayInvoiceId       String? @unique
  gatewayChargeId        String?

  invoiceNumber String?
  invoiceUrl    String?

  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

  /// Solo en destacados: anuncio al que corresponde el cobro.
  listingId String?
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  entitlements Entitlement[]

  /// Factura que incluye este cobro (RF.13). Null = aún sin facturar. Relación
  /// 1:1 vía InvoiceLine.transactionId @unique — guard duro anti-doble-facturación.
  invoiceLine InvoiceLine?

  /// Créditos extra congelados en el checkout para usuarios Pro. Null = sin bonus.
  /// Calculado en createCreditPackCheckout; el RedsysProcessor lo lee sin recalcular.
  bonusCreditAmount Int?

  /// Bonus de campaña promocional congelado en el checkout (H8 Bloque D). Null = sin
  /// campaña activa en ese instante. Se SUMA a bonusCreditAmount (Pro + campaña), no
  /// lo sustituye. El RedsysProcessor lo lee sin recalcular — el bonus vigente es el
  /// del instante del checkout, no el de la confirmación del pago.
  campaignBonusAmount     Int?
  /// Campaña #10 — bonus de campaña en packs de bumps, espejo bump de
  /// campaignBonusAmount arriba (misma fórmula, misma congelación). Null = sin
  /// campaña BUMP_BONUS activa en ese instante.
  campaignBonusBumpAmount Int?
  /// Campaña APLICADA a esta Transaction — CREDIT_BONUS si es un pack de
  /// créditos (ver campaignBonusAmount), BUMP_BONUS si es un pack de bumps
  /// (ver campaignBonusBumpAmount). NUNCA ambas a la vez: una Transaction es
  /// de una moneda o de la otra, nunca las dos. Para trazabilidad/reporting.
  /// Las campañas no se borran (solo se desactivan), pero SetNull es red de
  /// seguridad.
  campaignId              String?
  campaign                Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  /// Créditos base del pack, congelados en el checkout (Redsys). Igual que
  /// bonusCreditAmount/campaignBonusAmount: el processor NUNCA relee
  /// CreditPack.creditAmount en vivo, para que un cambio de precio admin no
  /// altere lo que un pago ya en curso otorga. Null en transacciones que no
  /// son de un pack de créditos, y en las creadas antes de este campo.
  baseCreditAmount Int?

  /// Monetización ráfaga 4 — bumps base de un BumpPack, congelados en el
  /// checkout. Mismo principio que baseCreditAmount, moneda distinta: el
  /// processor nunca relee BumpPack.bumpAmount en vivo. Null salvo en
  /// transacciones de pack de bumps.
  baseBumpAmount Int?

  /// Monetización ráfaga 4 — bumps extra de bonus Pro al comprar un BumpPack,
  /// congelados en el checkout (Setting proExtraBumpsPercent vigente en ESE
  /// instante). Null = sin bonus (no era Pro en el checkout). El processor
  /// los lee tal cual, nunca revalida isPro en la confirmación.
  bonusBumpAmount Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

/// Tabla de registro de eventos ya procesados de la pasarela.
/// Garantiza que un webhook duplicado no tenga efectos secundarios.
/// Solo se escribe; nunca se actualiza ni se borra.
model GatewayEvent {
  id String @id @default(cuid())

  /// ID único del evento en la pasarela (p.ej. "evt_1ABC..." en Stripe; Ds_Order en Redsys).
  gatewayEventId String @unique

  eventType String

  /// "STRIPE" | "REDSYS" — distingue el origen del evento para trazabilidad.
  gateway String @default("STRIPE")

  processedAt DateTime @default(now())

  @@index([processedAt])
}

// ============================================================================
//  WALLET Y CRÉDITOS
// ============================================================================

/// Pack de créditos comprable. El precio en EUR vive en el Price asociado (creditPackId).
/// Los costes de gastar créditos (featured, bump) viven en Setting.
model CreditPack {
  id           String  @id @default(cuid())
  name         String
  description  String? @db.Text
  /// Créditos que el usuario recibe al comprar este pack.
  creditAmount Int
  active       Boolean @default(true)

  /// Relación inversa: el Price asociado apunta a este pack vía creditPackId.
  price Price?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Monetización ráfaga 4 — pack de bumps DIRECTOS (acredita bumpBalance, no
/// créditos). Sustituye al mecanismo highlightBumps de la ráfaga 2 (Opción B,
/// retirado — ver CreditPack.highlightBumps). Tabla paralela a CreditPack, no
/// generalizada en una sola tabla `Pack{type}`: el checkout y el processor ya
/// ramifican por moneda de todas formas (Setting de bonus distinta, ledger
/// distinto, columna de Wallet distinta), así que unificar el catálogo no
/// habría evitado esa rama — solo habría obligado a renombrar
/// Transaction.baseCreditAmount/bonusCreditAmount a algo genérico, con mucho
/// radio de explosión sobre código ya verde. Ver diseno-facturacion.md §19.
model BumpPack {
  id          String  @id @default(cuid())
  name        String
  description String? @db.Text
  /// Bumps que el usuario recibe al comprar este pack (base, sin el bonus Pro).
  bumpAmount  Int
  active      Boolean @default(true)

  /// Relación inversa: el Price asociado apunta a este pack vía bumpPackId.
  price Price?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Saldo de créditos (y, desde la ráfaga 2, de bumps) de un usuario. Una fila
/// por usuario — las dos monedas comparten fila a propósito: se consumen en
/// la MISMA operación (bumpear intenta primero bumpBalance, luego balance), así
/// que vivir en la misma fila evita coordinar dos filas en cada bump.
///
/// INVARIANTE: balance >= 0 y bumpBalance >= 0. Ninguno se vuelve negativo.
/// El débito atómico via UPDATE ... WHERE balance >= N (o bumpBalance >= N)
/// garantiza este invariante sin serializable isolation. Ver
/// diseno-facturacion.md §3.2 para el patrón de créditos; §17 para bumps.
model Wallet {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Saldo en créditos enteros. Fuente de verdad del saldo actual.
  balance Int @default(0)

  /// Saldo de bumps gratis (moneda separada, intransferible, solo canjeable
  /// por bumps). NO caduca — misma decisión que balance, documentada en
  /// diseno-facturacion.md §17. Solo se acredita por cupón o a mano (soporte);
  /// no se compra directamente (ver Opción B: comprar bumps acredita balance,
  /// no bumpBalance).
  bumpBalance Int @default(0)

  entries     CreditLedger[]
  bumpEntries BumpLedger[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Registro inmutable de cada movimiento de créditos.
/// NUNCA se modifica ni se borra una fila de esta tabla.
/// amount > 0 = crédito (suma); amount < 0 = débito (resta).
model CreditLedger {
  id       String @id @default(cuid())
  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id])

  type CreditLedgerType

  /// Positivo = crédito (suma al saldo); negativo = débito (resta al saldo).
  amount Int

  /// Referencia polimórfica al recurso que originó el movimiento.
  /// Transaction.id para compras; Entitlement.id para destacados; Listing.id para bumps.
  /// Para bumps pagados con crédito: SIEMPRE 'Listing' + el id del anuncio —
  /// consultable sin ambigüedad junto con BumpLedger (ver su comentario).
  referenceId   String?
  referenceType String? // "Transaction" | "Entitlement" | "Listing"

  note String?

  createdAt DateTime @default(now())

  @@index([walletId])
  @@index([createdAt])
  @@index([referenceType, referenceId])
}

/// Registro inmutable de cada movimiento de saldo de bumps. Mismo molde que
/// CreditLedger, moneda separada.
///
/// HISTÓRICO SIN AMBIGÜEDAD (Monetización ráfaga 2, corrección pedida): para
/// saber con qué se pagó UN bump concreto, la consulta correcta es filtrar
/// CreditLedger y BumpLedger por referenceType='Listing' AND referenceId=<id>,
/// NUNCA por cercanía temporal a Listing.bumpedAt (ese campo se sobrescribe en
/// cada bump — no sirve de índice histórico). Cada fila de cualquiera de los
/// dos ledgers es, por sí sola, el registro permanente de UN evento de bump:
/// su createdAt es el instante exacto de ESE bump, y su sola presencia en un
/// ledger u otro (nunca ambos a la vez para el mismo evento) dice con qué se
/// pagó. Si un anuncio se bumpea varias veces, hay una fila por bump en el
/// ledger que corresponda — se leen todas, ordenadas por createdAt, sin
/// necesitar correlacionarlas con ningún otro campo del Listing.
model BumpLedger {
  id       String @id @default(cuid())
  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id])

  type BumpLedgerType

  /// Positivo = crédito (cupón, soporte); negativo = débito (bump consumido).
  amount Int

  referenceId   String?
  referenceType String? // "Coupon" | "Listing" | "User"

  note String?

  createdAt DateTime @default(now())

  @@index([walletId])
  @@index([createdAt])
  @@index([referenceType, referenceId])
}

// ============================================================================
//  BUMP AUTOMÁTICO (proyecto 2) — programación y ejecuciones
//
//  Ver docs/diseno-bump-automatico.md. Estas dos tablas son SOLO el modelo: el
//  scheduler que las lee y escribe llega en la ráfaga siguiente.
//
//  NO TOCAN NADA DE LO EXISTENTE. En particular NO son el libro mayor: el
//  invariante `wallet.bumpBalance == SUM(BumpLedger.amount)` sigue siendo cosa
//  exclusiva de BumpLedger. BumpRun es un registro de EJECUCIÓN que apunta al
//  mismo hecho desde fuera, y por eso puede existir sin que se cobrara nada
//  (un turno saltado por cooldown también deja fila).
// ============================================================================

/// Por qué una programación no está corriendo. Enum y no un `paused: boolean`
/// porque LA RAZÓN DETERMINA LA SALIDA: «recarga créditos» y «reactiva tu
/// anuncio» son mensajes distintos, y la reanudación automática de D9 solo puede
/// existir si consta que la pausa fue por esa causa concreta. Misma lección que
/// `motivoNoDisponible` en FacturasPanel (UXV.3/M7): un estado bloqueado sin
/// razón visible es un callejón.
enum BumpScheduleStatus {
  /// Corriendo: el cron la considerará en cuanto venza `nextRunAt`.
  ACTIVE
  /// La paró el usuario.
  PAUSED_BY_USER
  /// D2 — se agotaron las TRES bolsas (cuota Pro, saldo de bumps y créditos).
  /// Reanudación MANUAL: los créditos son una bolsa común y recargarlos para
  /// otra cosa no debe reactivar gasto que el usuario no ha vuelto a pedir.
  PAUSED_NO_FUNDS
  /// D9 — el anuncio dejó de estar ACTIVE (vendido, archivado, caducado,
  /// moderado). Reanudación AUTOMÁTICA al volver a ACTIVE: ahí el gesto del
  /// usuario apunta al mismo objeto que la programación.
  PAUSED_LISTING_INACTIVE
}

/// Cómo acabó un turno. `SKIPPED_*` = no se intentó cobrar; `FAILED_*` = se
/// intentó y no pudo. La distinción importa porque solo los FAILED pausan.
enum BumpRunOutcome {
  /// Se aplicó el bump. `paidWith` y `cost` dicen con qué se pagó.
  APPLIED
  /// D5 — había un bump reciente (normalmente manual) dentro de la ventana de
  /// cooldown. El turno se pierde, SIN cobro y sin aviso: el usuario acaba de
  /// bumpear a mano, no necesita que le cuenten que por eso no se bumpeó otra vez.
  SKIPPED_COOLDOWN
  /// El anuncio no estaba ACTIVE al ejecutar (D9).
  SKIPPED_LISTING_INACTIVE
  /// D2 — sin nada con que pagar.
  FAILED_NO_FUNDS
  /// Cualquier otro error. No debería ocurrir; consta para poder investigarlo.
  FAILED_ERROR
}

/// La INTENCIÓN del usuario: «este anuncio, cada tantos días, a tal hora».
///
/// D1 (frecuencia) se materializa en `intervalDays` + `hourOfDay`: «cada 7 días a
/// las 9:00» ya es un viernes recurrente sin necesidad de modelar días de la
/// semana. NO hay campo `weekday` porque D1 se confirmó como «cada N días», ni
/// `frozenCreditCost` porque D10 se confirmó como «cobrar el precio vigente», ni
/// `fundingPolicy` porque D11 se confirmó como «mismo orden que el manual». Los
/// tres son campos que el diseño dejó marcados como condicionales y que las
/// decisiones confirmadas NO piden: no existen a propósito.
model BumpSchedule {
  id String @id @default(cuid())

  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  /// El dueño del bolsillo. Redundante con `listing.sellerId` a propósito: el
  /// tope por usuario (D3) se comprueba en cada alta y hacerlo con un JOIN a
  /// Listing en un camino caliente es peor que una columna. Además lo que se
  /// cobra es la cartera del USUARIO, así que las consultas de dinero no deberían
  /// depender de una relación del anuncio.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// D1 — cada cuántos días. Mínimo 1: aunque el cooldown (1 h) permita 24 bumps
  /// diarios, eso es gasto desatendido que nadie configura a conciencia. El
  /// cooldown protege la plataforma; este mínimo protege al usuario. El rango
  /// (1..30) lo valida el DTO en la ráfaga de negocio, no la base.
  intervalDays Int

  /// D4 — hora del día, 0..23, en HORA PENINSULAR (Europe/Madrid), declarada y
  /// mostrada como tal. No hay zona horaria por usuario: `User` no tiene ese
  /// campo y un marketplace español no justifica su coste. Con cron horario «las
  /// 9:00» significa «en la pasada de las 9:00», y la UI lo redacta como franja.
  hourOfDay Int

  status BumpScheduleStatus @default(ACTIVE)

  /// EL INSTANTE DEL PRÓXIMO TURNO. Columna materializada, no cálculo: es lo que
  /// el cron consulta e indexa y —sobre todo— es el ancla del reclamo de la CAPA
  /// 2. Un valor calculado no se puede reclamar, y de este valor sale la `slot`
  /// (ver BumpRun.slot).
  nextRunAt DateTime

  /// Último intento, se cobrara o no. Informativo; la verdad de cada turno está
  /// en BumpRun.
  lastRunAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  runs BumpRun[]

  /// D3 — UNA programación por anuncio. No es cosmético: dos programaciones sobre
  /// el mismo anuncio competirían por el mismo cooldown y una de las dos no haría
  /// nada nunca. Lo impide la base, no una comprobación que se pueda olvidar.
  @@unique([listingId])
  /// LA consulta del cron: `status = ACTIVE AND nextRunAt <= now`. Sin este
  /// índice, cada pasada horaria recorre la tabla entera.
  @@index([status, nextRunAt])
  @@index([userId])
}

/// Un TURNO de una programación, se haya cobrado o no.
///
/// ES EL CORAZÓN DE LA IDEMPOTENCIA (CAPA 2) y, de paso, cierra el hueco B.4 de
/// la auditoría: hoy ni `BumpLedgerType` ni `CreditLedger.referenceType`
/// distinguen un bump automático de uno manual, así que sin esta tabla el usuario
/// vería créditos gastados sin poder reconstruir por qué. Se consigue SIN tocar
/// el ledger: esto es un registro paralelo, no un apunte contable.
model BumpRun {
  id String @id @default(cuid())

  scheduleId String
  schedule   BumpSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  /// EL INSTANTE PREVISTO DEL TURNO — nunca el de ejecución.
  ///
  /// DEFINICIÓN CANÓNICA, de la que depende que la idempotencia funcione: `slot`
  /// es el valor que `BumpSchedule.nextRunAt` TENÍA cuando el turno se reclamó,
  /// copiado tal cual. No se recalcula, no se trunca, no se deriva de `now()`.
  ///
  /// Por qué así y no de otra forma: dos instancias del cron que procesan el mismo
  /// turno leen la MISMA fila y por tanto el MISMO `nextRunAt`, así que computan
  /// la misma `slot` y colisionan en la clave única de abajo. Si `slot` saliera de
  /// la hora de ejecución, dos instancias separadas por milisegundos producirían
  /// valores distintos, no colisionarían, y el guard no guardaría nada.
  ///
  /// Corolario para el scheduler (ráfaga siguiente): la `slot` se toma ANTES de
  /// avanzar `nextRunAt`, y se copia; el turno recuperado tarde (servidor caído)
  /// conserva su instante previsto original, que es lo que lo hace reproducible.
  slot DateTime

  /// NULL = turno RECLAMADO pero todavía sin desenlace.
  ///
  /// La fila se crea ANTES de cobrar —ese es el reclamo, y es lo que impide que dos
  /// instancias cobren el mismo turno— así que en el instante del INSERT el resultado
  /// aún no existe. El scheduler lo rellena después con lo que devolvió
  /// `BillingService.bump`.
  ///
  /// Un NULL que sobrevive a la pasada significa que el proceso murió entre reclamar y
  /// resolver: el turno se perdió (nunca se cobró dos veces, que es lo que importa) y
  /// queda la constancia de que ocurrió, en vez de un silencio.
  outcome BumpRunOutcome?

  /// Con qué se pagó, tal cual lo devuelve `BillingService.bump`: PRO_QUOTA |
  /// BUMP_BALANCE | CREDITS. Null si no se llegó a cobrar. String y no enum
  /// porque el valor lo produce el servicio de cobro, no este modelo: duplicarlo
  /// como enum crearía dos listas que pueden divergir.
  paidWith String?

  /// Créditos cobrados. 0 cuando fue gratis (cuota Pro o saldo de bumps), null
  /// cuando no se cobró nada. D10 — se guarda lo REALMENTE cobrado en ese turno,
  /// porque el precio se lee en vivo y puede haber cambiado desde que se programó.
  cost Int?

  /// Motivo legible cuando no se aplicó. Para soporte y para la vista de
  /// «Bumps programados»; nunca para decidir nada en código.
  detail String?

  /// Cuándo se ejecutó DE VERDAD (distinto de `slot` si la pasada se retrasó).
  createdAt DateTime @default(now())

  /// EL GUARD FUERTE DE LA CAPA 2. Dos procesos que intenten el mismo turno no
  /// pueden crear dos filas: el segundo choca contra esta restricción. Es el molde
  /// de `Invoice.idempotencyKey @unique`, que existe por la misma razón (emitir dos
  /// veces es grave) y con el mismo criterio: el guard que de verdad no se puede
  /// esquivar vive en la BASE, no en el código.
  @@unique([scheduleId, slot])
  /// Historial de una programación, del turno más reciente hacia atrás.
  @@index([scheduleId, createdAt])
}

/// Campaña promocional gestionada desde el backoffice (H8 Bloque D). El MOTOR es
/// genérico: CREDIT_BONUS (fase 1) y ACTION_DISCOUNT (fase 2). Los cupones
/// canjeables (fase 3) NO son un CampaignType — viven en su propio modelo
/// (Coupon/CouponRedemption, más abajo): un cupón tiene código/límite/registro
/// de canjes que no encajan en la aplicación automática de Campaign. Difusión/
/// banners queda para fase 4.
///
/// Decisión de producto: no se permiten dos campañas ACTIVE del MISMO type (y,
/// para ACTION_DISCOUNT, de la MISMA params.action) con fechas solapadas
/// (validado en CampaignsService al crear/editar). Así nunca hay ambigüedad de
/// "cuál aplicar" — a lo sumo una campaña de un type(+action) dado está vigente
/// en un instante dado. Campañas de types (o acciones) distintos sí conviven.
model Campaign {
  id       String       @id @default(cuid())
  name     String
  type     CampaignType
  active   Boolean      @default(true)
  startsAt DateTime
  endsAt   DateTime

  /// Parámetros específicos del type. Para CREDIT_BONUS:
  /// { "kind": "PERCENT" | "FIXED", "value": number }. Para ACTION_DISCOUNT:
  /// { "action": "BUMP" | "FEATURED", "percent": number }.
  /// Validado en el DTO según `type`, no a nivel de BD (mismo patrón que
  /// Setting.value / Listing.attributes) — evita migración por cada type nuevo.
  params Json

  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, active, startsAt, endsAt])
}

/// Recompensa que otorga un Coupon al canjearse (H8 Bloque D fase 3).
enum CouponRewardType {
  CREDITS
  FEATURED
  /// Monetización ráfaga 2 — acredita BumpLedger.amount al bumpBalance del
  /// usuario, no CreditLedger/balance. Disponible para cualquier usuario
  /// (Pro o no), igual que CREDITS/FEATURED: este sistema no distingue plan.
  BUMP
}

/// Cupón canjeable por código. A diferencia de Campaign, NO usa `params` Json:
/// el espacio de recompensas es cerrado (CREDITS | FEATURED, sin más tipos
/// previstos), así que columnas explícitas son más claras que Json aquí — no
/// hace falta el switch de validación manual que sí necesita Campaign.
///
/// `redemptionCount` es un CONTADOR FÍSICO (no un COUNT derivado como la cuota
/// Pro) — el límite total se hace cumplir con un incremento atómico condicional
/// (mismo patrón que el débito de Wallet), sin lock explícito. Ver
/// CouponsService.redeem.
///
/// onePerUser es SIEMPRE true en esta fase (simplificación aprobada en el mini-
/// diseño): un `@@unique([couponId, userId])` en CouponRedemption lo hace
/// cumplir a nivel de BD, sin configurabilidad — soportar cupones reutilizables
/// por el mismo usuario reintroduciría la misma complejidad de "límite por
/// usuario" que este diseño evita para el límite total.
model Coupon {
  id         String           @id @default(cuid())
  /// Normalizado a MAYÚSCULAS al crear y al canjear (evita "Verano2026" vs "VERANO2026").
  code       String           @unique
  rewardType CouponRewardType

  /// Solo si rewardType = CREDITS.
  creditAmount         Int?
  /// Solo si rewardType = FEATURED.
  featuredDurationDays Int?
  /// Solo si rewardType = BUMP.
  bumpAmount           Int?

  /// null = ilimitado.
  maxRedemptions  Int?
  redemptionCount Int  @default(0)

  active   Boolean  @default(true)
  startsAt DateTime
  endsAt   DateTime

  redemptions CouponRedemption[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([active, startsAt, endsAt])
}

/// Registro de canje — uno por [couponId, userId] (onePerUser, ver Coupon).
/// NUNCA se borra ni se modifica: historial permanente de canjes.
model CouponRedemption {
  id         String   @id @default(cuid())
  couponId   String
  coupon     Coupon   @relation(fields: [couponId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  redeemedAt DateTime @default(now())

  /// Trazabilidad polimórfica de qué se otorgó: 'CreditLedger' + id de la
  /// entrada (CREDITS), o 'Entitlement' + id del FEATURED_LISTING (FEATURED).
  referenceType String
  referenceId   String

  @@unique([couponId, userId])
  @@index([couponId])
}

// ============================================================================
//  BANNERS DE DIFUSIÓN (H8 Bloque D fase 4)
// ============================================================================

/// Ubicación donde puede aparecer un Banner. Array escalar en Banner.placements
/// (un banner puede vivir en varias a la vez) — mismo patrón que Post.tags.
enum BannerPlacement {
  HOME
  MIS_ANUNCIOS
}

/// Estilo visual del banner (puramente presentacional, sin efecto en la lógica).
enum BannerVariant {
  INFO
  PROMO
  WARNING
}

/// Banner de difusión configurable desde admin — hace visibles campañas/cupones
/// que de otro modo son invisibles para el usuario. Manual, NO derivado
/// automáticamente de Campaign/Coupon (`linkUrl` de texto libre es suficiente;
/// ver mini-diseño para la justificación de por qué no hay FK a esas entidades).
///
/// A diferencia de Coupon.code, NINGÚN campo es inmutable tras crear: un banner
/// no se distribuye fuera de la app, así que editar título/texto/placements no
/// rompe nada externo.
model Banner {
  id    String @id @default(cuid())
  title String
  text  String @db.Text

  linkUrl  String?
  linkText String?

  /// Ubicaciones donde se muestra. No puede quedar vacío (validado en el DTO).
  placements BannerPlacement[]

  variant BannerVariant @default(INFO)

  /// Si true, se ofrece el botón "Compartir" (navigator.share o portapapeles).
  shareable Boolean @default(false)
  /// Texto a compartir si difiere de `text`. Si es null, se comparte `text`.
  shareText String?

  active   Boolean  @default(true)
  startsAt DateTime
  endsAt   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, startsAt, endsAt])
}

/// Anuncio PUBLICITARIO EXTERNO gestionado por admin (H6.6) — NO es un Listing
/// promocionado del marketplace. Se inyecta entre los resultados de búsqueda de
/// su categoría (o de las hijas de esta). Sin billing: gestión 100% manual.
model SponsoredAd {
  id          String @id @default(cuid())
  imageUrl    String
  title       String
  description String @db.Text
  /// Enlace EXTERNO (fuera del marketplace); se abre en pestaña nueva.
  targetUrl   String

  categoryId String
  /// onDelete por defecto (RESTRICT, igual que Listing.categoryId): borrar una
  /// categoría con patrocinados debe rechazarse explícitamente (ver
  /// AdminService.deleteCategory), no Cascade silencioso — un patrocinado
  /// huérfano de categoría no tiene dónde inyectarse.
  category   Category @relation(fields: [categoryId], references: [id])

  /// Desempate cuando hay varios patrocinados activos para la misma categoría
  /// (asc; empate → más reciente). No es un array de posiciones en la parrilla.
  order Int @default(0)

  active   Boolean   @default(true)
  /// A diferencia de Banner, ambos son opcionales: un patrocinado puede no
  /// tener ventana de vigencia y permanecer activo indefinidamente mientras
  /// `active` sea true.
  startsAt DateTime?
  endsAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId, active])
}

// ============================================================================
//  BLOG
// ============================================================================

/// Post editorial del blog, gestionado exclusivamente desde el backoffice admin.
/// El cuerpo se almacena como Markdown raw; la conversión a HTML ocurre en el
/// frontend (react-markdown + rehype-sanitize) para evitar XSS almacenado.
model Post {
  id              String     @id @default(cuid())
  /// POST (artículo, /blog/{slug}) o PAGE (página informativa, /paginas/{slug}).
  /// Default POST cubre las filas existentes sin backfill. Inmutable tras crear
  /// (UpdatePostDto no lo acepta) — cambiar el tipo movería el contenido de feed/URL.
  type            PostType   @default(POST)
  title           String
  /// Slug único para la URL pública: /blog/{slug} o /paginas/{slug}. Único a nivel
  /// global (un post y una página no pueden compartir slug).
  slug            String     @unique
  /// Resumen corto: aparece en tarjetas de listado y como meta description fallback.
  /// En PAGE solo se usa como fallback de metaDescription (no hay listado de páginas).
  excerpt         String?    @db.Text
  /// Sistema de bloques: array ORDENADO (la posición en el array es el orden,
  /// no hay campo `order` por bloque) de objetos { id, type, ...datos }, unión
  /// discriminada por `type` en TS/DTOs (9 tipos: text, faq, hub, image, cta,
  /// quote, video, separator, table). Sustituye al `body: String` Markdown
  /// (corte limpio, sin migración — ver commands/ para el seed de QA).
  /// Validado en profundidad en el DTO (discriminador class-transformer) y en
  /// el servicio (reglas cruzadas, p. ej. table.rows[i].length === headers.length).
  blocks          Json       @default("[]")
  status          PostStatus @default(DRAFT)
  /// URL de la imagen de portada (obtenida vía POST /media/upload). En PAGE es
  /// opcional y solo se usa como OG image, nunca como hero visual de la página.
  coverUrl        String?
  /// Overrides SEO opcionales; si son null se usan title/excerpt como fallback.
  metaTitle       String?
  metaDescription String?    @db.Text
  /// Etiquetas planas como slugs (p.ej. ["consejos", "segunda-mano"]). No aplica a
  /// PAGE (campo oculto en el formulario de páginas).
  tags            String[]   @default([])
  authorId        String
  author          User       @relation("PostAuthor", fields: [authorId], references: [id])
  /// Gating de publicación y auditoría. En PAGE no se muestra en la propia página.
  publishedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  /// Ítems de navegación del footer que enlazan a esta página (type=PAGE). Un
  /// Post con footerItems no vacío no puede borrarse (ver FooterItem.page,
  /// onDelete: Restrict) — el servicio precomprueba y da un 400 legible antes
  /// de que la constraint física falle.
  footerItems FooterItem[]

  /// Ítems del nav principal que enlazan a esta página (type=PAGE). SEGUNDA
  /// fuente de enlaces a páginas, con la misma protección que footerItems (ver
  /// NavItem.page, onDelete: Restrict): el precheck de BlogService.adminDelete
  /// debe contar LAS DOS tablas, o borrar una página enlazada solo desde el nav
  /// pasaría el chequeo y reventaría contra la constraint como un 500.
  navItems NavItem[]

  @@index([type, status, publishedAt])
}

// ============================================================================
//  FOOTER NAVIGATION — estructura propia (columnas + ítems), independiente del
//  contenido (Post). Un ítem apunta a página del CMS / ruta interna / URL
//  externa — ver FooterItem para el destino discriminado.
// ============================================================================

/// Tipo de destino de un FooterItem. Discrimina qué campo del destino aplica
/// (pageId vs url) — validado en el servicio, no con un CHECK de schema
/// (mismo estilo que Post.assertFooterFieldsAllowed).
enum FooterItemType {
  PAGE
  INTERNAL
  EXTERNAL
}

model FooterColumn {
  id        String       @id @default(cuid())
  /// null = columna sin encabezado (mismo significado que footerGroup=null
  /// en el sistema anterior basado en Post).
  name      String?
  order     Int          @default(0)
  items     FooterItem[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model FooterItem {
  id       String         @id @default(cuid())
  columnId String
  column   FooterColumn   @relation(fields: [columnId], references: [id], onDelete: Cascade)
  /// Texto visible del enlace — independiente de Post.title (el admin puede
  /// acortarlo/personalizarlo sin tocar la página).
  label    String
  order    Int            @default(0)
  type     FooterItemType

  /// Solo type=PAGE. onDelete: Restrict — borrar una página enlazada desde el
  /// footer debe rechazarse con un 400 legible (precomprobado en el
  /// servicio), nunca reventar en silencio ni borrar el ítem sin avisar.
  pageId String?
  page   Post?   @relation(fields: [pageId], references: [id], onDelete: Restrict)

  /// type=INTERNAL (ruta relativa, sin registro de rutas reales — ver nota en
  /// el DTO) o type=EXTERNAL (URL absoluta). null si type=PAGE.
  url String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([columnId, order])
}

// ============================================================================
//  NAVEGACIÓN PRINCIPAL (RN.1) — barra bajo el header del sitio público.
//  Árbol propio (menús → submenús desplegables), independiente del contenido
//  (Post) y del footer. NO reusa FooterColumn/FooterItem: ese modelo es plano
//  por construcción (una columna no es un enlace y un ítem no tiene hijos) y
//  no escala a submenús. Ver docs/diseno-nav-dinamico.md.
// ============================================================================

/// Tipo de destino de un NavItem. Mismos tres valores y misma semántica que
/// FooterItemType — enum aparte, y no reutilizado, porque los dos sistemas
/// deben poder divergir sin arrastrarse.
enum NavItemType {
  PAGE
  INTERNAL
  EXTERNAL
}

/// Tipos de página de (public) donde un NavItem puede mostrarse. Derivado del
/// árbol REAL de apps/web/src/app/(public), no de una lista conceptual: cada
/// valor se corresponde con un layout anidado que declara el suyo (patrón
/// BannerPlacement, ver diseño §4.2). Nombres en español como
/// BannerPlacement.MIS_ANUNCIOS: nombran rutas de cara al usuario.
///
/// CATEGORIA cubre /[categoria] y /[categoria]/[subcategoria], y BLOG cubre el
/// índice y la ficha: renderizan por el mismo componente y cuelgan del mismo
/// layout. Separarlos después es una migración aditiva sin backfill (molde
/// ContactReasonScope); fusionarlos obligaría a reescribir los `visibleOn` ya
/// guardados — por eso se empieza grueso.
enum NavPageType {
  HOME
  BUSQUEDA
  CATEGORIA
  ANUNCIO
  BLOG
  PAGINA_CMS
  VENDEDOR
  CONTACTO
  PLANES
}

model NavItem {
  id String @id @default(cuid())

  /// Auto-relación: un nodo puede colgar de otro. null = nodo raíz (primer
  /// nivel de la barra). Cascade: borrar un menú se lleva su subárbol — es una
  /// acción consciente del admin y la UI anuncia cuántos descendientes se van
  /// ANTES de confirmar (mismo criterio que FooterItem.column). A diferencia
  /// de Category.parentId (SET NULL físico + rechazo en el servicio), de un
  /// NavItem no cuelga ningún tercero que pueda sorprenderse.
  ///
  /// La profundidad la acota el SERVICIO (NAV_MAX_DEPTH), no el schema — mismo
  /// criterio que Category, cuyo tope de 2 niveles vive en assertParentIsRoot.
  parentId String?
  parent   NavItem?  @relation("NavTree", fields: [parentId], references: [id], onDelete: Cascade)
  children NavItem[] @relation("NavTree")

  /// Texto visible del enlace — independiente de Post.title, igual que
  /// FooterItem.label (el admin puede acortarlo sin tocar la página).
  label String
  order Int    @default(0)

  /// Desactivar oculta el nodo Y su subárbol entero: un hijo de un padre
  /// inactivo NO se promociona a raíz (ver el paso 1 de la poda en
  /// nav.types.ts). Es el interruptor rápido que el footer no tiene.
  active Boolean @default(true)

  /// NULLABLE — ésta es la diferencia estructural con FooterItem.type.
  /// null = nodo solo-desplegable (sin destino propio, abre sus hijos).
  /// La coherencia con pageId/url se valida en el SERVICIO, no aquí, igual que
  /// FooterService.assertItemDestination: Prisma no la valida por sí solo y no
  /// hay CHECK de schema.
  ///
  /// Un nodo sin destino Y sin hijos es INVÁLIDO, pero se acepta al escribir y
  /// se PODA AL LEER (diseño §2.3): rechazarlo con un 400 haría imposible crear
  /// un desplegable, porque el padre nace siempre antes que su primer hijo.
  type NavItemType?

  /// Solo type=PAGE. onDelete: Restrict, igual que FooterItem.page — borrar una
  /// página enlazada desde el nav debe rechazarse con un 400 legible
  /// (precomprobado en BlogService.adminDelete, que cuenta las DOS tablas),
  /// nunca reventar en silencio.
  pageId String?
  page   Post?   @relation(fields: [pageId], references: [id], onDelete: Restrict)

  /// type=INTERNAL (ruta relativa, sin registro de rutas reales — misma
  /// limitación aceptada que FooterItem.url) o type=EXTERNAL (URL absoluta).
  /// null si type=PAGE o si type es null.
  url String?

  /// Tipos de página donde se muestra. [] = SIN FILTRO, se muestra en TODAS —
  /// diverge a propósito de Banner.placements, que prohíbe el vacío. Allí un
  /// banner sin ubicación es peso muerto; aquí "aparecer en todas partes" es el
  /// caso mayoritario de un nav, y ese debe ser el estado por defecto. Mismo
  /// significado de "[] = no configurado" que Category.allowedViews.
  visibleOn NavPageType[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId, order])
}

// ============================================================================
//  CONTACTO PÚBLICO (RC.1)
// ============================================================================

/// Estado de gestión de un mensaje de contacto.
enum ContactEstado {
  NUEVO
  LEIDO
  RESPONDIDO
  CERRADO
}

/// Dónde se ofrece un ContactReason (atención al usuario R1, §14.1 del diseño).
/// El formulario público de /contacto y los tickets de un usuario registrado no
/// comparten taxonomía real ("consulta general" vs. "problema con mi factura"),
/// pero sí comparten el CRUD de admin ya construido (/admin/motivos-contacto,
/// con reorden y sin DELETE) — de ahí una columna de ámbito en vez de una tabla
/// gemela. @default(PUBLIC) preserva EXACTAMENTE el comportamiento de los motivos
/// existentes sin backfill: Prisma escribe el default en las filas ya creadas al
/// aplicar la migración, y /contacto los sigue ofreciendo igual. Mismo criterio
/// que Category.allowedListingType @default(BOTH).
enum ContactReasonScope {
  PUBLIC // Solo en el formulario público /contacto
  TICKET // Solo al abrir un ticket de atención al usuario
  BOTH // En ambos
}

/// Motivo de contacto configurable por el admin (RC.2) — reemplaza al enum
/// ContactMotivo. Sin DELETE, solo desactivación (molde Banner/SponsoredAd):
/// un motivo desactivado deja de ofrecerse en /contacto, pero los mensajes
/// históricos conservan su motivoId intacto — nunca se borra. `orden` define
/// cómo aparece en el <select> público y se reordena con flechas ↑↓ (molde
/// categorías/footer). Guard en el service: no se puede desactivar el último
/// motivo activo (el formulario público se quedaría sin opciones).
model ContactReason {
  id        String   @id @default(cuid())
  nombre    String
  orden     Int      @default(0)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Ámbito donde se ofrece este motivo. Ver ContactReasonScope: el default
  /// PUBLIC deja intacto el comportamiento de /contacto. El filtro por scope lo
  /// aplicará quien ofrezca el select (R2/R3); en R1 solo existe la columna.
  scope ContactReasonScope @default(PUBLIC)

  messages ContactMessage[]
  tickets  Ticket[]         @relation("TicketTopic")

  @@index([activo, orden])
}

/// Mensaje enviado desde /contacto (público, sin autenticación). Sin columna de
/// IP: decisión RGPD — la IP solo vive en Redis (rate limiting, TTL corto), nunca
/// se persiste junto a los datos del remitente. Sin relación a User: el remitente
/// no está autenticado.
model ContactMessage {
  id        String        @id @default(cuid())
  motivoId  String
  /// onDelete: Restrict — un ContactReason con mensajes no puede borrarse
  /// (de todos modos no hay endpoint DELETE; se desactiva, nunca se borra).
  motivo    ContactReason @relation(fields: [motivoId], references: [id], onDelete: Restrict)
  email     String
  telefono  String?
  mensaje   String        @db.Text
  estado    ContactEstado @default(NUEVO)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  replies ContactReply[]

  @@index([estado, createdAt])
}

/// Respuesta del admin a un ContactMessage. Modelo separado (no un campo
/// mutable en ContactMessage) — permite responder más de una vez y deja rastro
/// auditable de qué se envió exactamente (asunto/cuerpo), a diferencia de
/// AuditLog que solo registra la acción, no el contenido del email.
model ContactReply {
  id               String         @id @default(cuid())
  contactMessageId String
  contactMessage   ContactMessage @relation(fields: [contactMessageId], references: [id], onDelete: Cascade)
  adminUserId      String
  admin            User           @relation("ContactReplyAdmin", fields: [adminUserId], references: [id])
  asunto           String
  cuerpo           String         @db.Text
  sentAt           DateTime       @default(now())

  @@index([contactMessageId])
}

// ============================================================================
//  FACTURACIÓN FISCAL — EMISIÓN DE FACTURAS (RF.13)
// ============================================================================
// Capa SEPARADA de la de cobros: Transaction registra el COBRO; Invoice es el
// DOCUMENTO FISCAL que lo acredita. La emisión conforme la aporta un proveedor
// homologado externo tras InvoicingProvider — nosotros orquestamos, congelamos
// los datos y guardamos el resultado (número, PDF, VeriFactu). El sistema NO
// afirma conformidad fiscal por sí mismo. Ver docs/diseno-facturacion.md §13.

/// Factura emitida. APPEND-ONLY e INMUTABLE una vez ISSUED. El número NO lo
/// generamos nosotros: lo asigna el proveedor (correlativo garantizado por él) y
/// es null hasta emitir. Una factura agrupa 1..N Transactions (recapitulativa;
/// 1:1 = una sola línea). Corrección = rectificativa nueva (rectifiesInvoiceId),
/// nunca UPDATE de esta. El bloqueo de UPDATE post-ISSUED se refuerza a nivel de
/// BD/middleware en R2 (no solo en la capa de servicio).
///
/// ALCANCE DE LA INMUTABILIDAD (Decisión Opción A, 2026-07-27): el guard de BD
/// (triggers BEFORE UPDATE/DELETE, migración 20260727000001_invoice_immutability_guard)
/// protege las vías-de-APLICACIÓN (UPDATE/DELETE). NO cubre TRUNCATE — los triggers
/// BEFORE de fila no se disparan con él: decisión consciente, TRUNCATE exige un
/// superusuario/owner que la app NO tiene en producción, y contra ese actor ningún
/// trigger protege (puede desactivarlo); la fuente de verdad fiscal definitiva la
/// conserva el proveedor homologado. Ver estado-tecnico.md.
model Invoice {
  id String @id @default(cuid())

  /// Número correlativo asignado por el PROVEEDOR. Null hasta ISSUED. Único.
  number String? @unique
  /// Serie/ejercicio del proveedor, si aplica (el proveedor es dueño de la serie).
  series String?

  type   InvoiceType   @default(ORDINARY)
  status InvoiceStatus @default(DRAFT)
  origin InvoiceOrigin

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  // --- Receptor CONGELADO (copia en el momento de emitir) ---
  receiverTaxId      String?
  receiverName       String?
  receiverEntityType FiscalEntityType?
  receiverAddress    String?
  receiverCity       String?
  receiverPostalCode String?
  receiverProvince   String?
  receiverCountry    String?

  // --- Emisor CONGELADO (copia de Setting fiscalIssuer en el momento de emitir) ---
  issuerTaxId      String?
  issuerName       String?
  issuerAddress    String?
  issuerCity       String?
  issuerPostalCode String?
  issuerProvince   String?
  issuerCountry    String?

  // --- Totales CONGELADOS (suma de líneas; provienen de Transaction) ---
  currency    String  @default("EUR")
  subtotalNet Decimal @db.Decimal(10, 2)
  totalTax    Decimal @db.Decimal(10, 2)
  totalGross  Decimal @db.Decimal(10, 2)

  /// Periodo de OPERACIÓN al que corresponde (ej. "2026-Q3" o "2026-07"), para
  /// agrupar/filtrar. Distinto de issuedAt (fecha de EMISIÓN): la emisión puede
  /// caer en otro trimestre o año que la operación.
  periodKey String?

  /// Fecha de emisión. Null hasta ISSUED.
  issuedAt DateTime?

  // --- Resultado del PROVEEDOR (referencias, no las generamos) ---
  pdfKey        String? // Clave PRIVADA en R2 (nunca URL pública)
  verifactuHash String?
  verifactuQr   String? @db.Text
  providerRef   String? // Id/eco de idempotencia del proveedor

  // --- Rectificativa: vínculo a la original (no re-lía Transactions) ---
  rectifiesInvoiceId String?
  rectifies          Invoice?  @relation("Rectification", fields: [rectifiesInvoiceId], references: [id])
  rectifiedBy        Invoice[] @relation("Rectification")

  /// Guard de idempotencia de la emisión automática: "userId:periodKey" en
  /// AUTO_PERIODIC (null en el resto). @unique ⇒ dos jobs del mismo usuario+periodo
  /// no pueden crear dos facturas. Ver diseño §C (triple guard).
  idempotencyKey String? @unique

  lines InvoiceLine[]

  /// Atención al usuario R1 — tickets que hablan de esta factura. Relación inversa
  /// solamente: la inmutabilidad de la factura no se ve afectada (un Ticket no
  /// escribe nada en Invoice, y los triggers BEFORE UPDATE/DELETE siguen intactos).
  tickets Ticket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([periodKey])
  @@index([issuedAt])
}

/// Línea de factura = un cobro (Transaction) facturado, con su snapshot CONGELADO.
/// transactionId es @unique: una Transaction cabe en UNA sola línea — es el guard
/// duro anti-doble-facturación a nivel de BD (invariante como bumpBalance==SUM,
/// pero fiscal). Una rectificativa referencia la factura original, NO re-crea
/// líneas sobre las mismas Transactions.
model InvoiceLine {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  transactionId String      @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  /// Concepto legible congelado ("Suscripción Pro", "Pack 150 créditos", "Destacado 30d").
  concept       String
  amountNet     Decimal  @db.Decimal(10, 2)
  taxAmount     Decimal  @db.Decimal(10, 2)
  taxRate       Decimal  @db.Decimal(5, 4)
  amountGross   Decimal  @db.Decimal(10, 2)
  /// Fecha del cobro (Transaction.createdAt), congelada.
  operationDate DateTime

  @@index([invoiceId])
}

// ============================================================================
//  ATENCIÃ“N AL USUARIO â€” TICKETS (R1)
// ============================================================================
// Canal bidireccional y trazable usuario â†” administraciÃ³n. La CONVERSACIÃ“N AQUÃ
// ES LA FUENTE DE VERDAD: Notification y email (R4) solo avisan y reenganchan,
// nunca transicionan un estado ni transportan el hilo. Sistema INDEPENDIENTE de
// ContactMessage (que es el canal anÃ³nimo, sin userId ni hilo bidireccional) y de
// Conversation (anclada a @@unique([listingId, buyerId]) y a comprador/vendedor).
// Ver docs/diseno-atencion-usuario.md Â§5 y Â§6.

/// Ciclo de vida de un ticket de atenciÃ³n al usuario.
///
/// CLOSED es IRREVERSIBLE: ninguna transiciÃ³n sale de Ã©l. Se hace cumplir igual
/// que ListingStatus.ARCHIVED â€” CLOSED no aparece como estado ORIGEN en ninguno
/// de los arrays de transiciÃ³n de TicketsService (STAFF_REPLYABLE, USER_REPLYABLE,
/// RESOLVABLE, CLOSABLE), asÃ­ que ningÃºn mÃ©todo lo acepta como punto de partida.
/// No hay guard de BD (triggers) a propÃ³sito: eso estÃ¡ reservado a lo fiscal
/// (Invoice), no es higiene general. Ver diseno-atencion-usuario.md Â§7.
enum TicketStatus {
  OPEN // Abierto, sin atender aÃºn
  IN_PROGRESS // Un agente lo ha tomado (assignedToId != null)
  WAITING_USER // La administraciÃ³n respondiÃ³; la pelota estÃ¡ en el usuario
  RESOLVED // La administraciÃ³n lo da por resuelto. Reabrible por el usuario (T8).
  CLOSED // Cerrado definitivamente. IRREVERSIBLE.
}

/// CuÃ¡l de los TRES FLUJOS originÃ³ el ticket. Columna propia (no derivada de
/// openedById == userId) porque REPORT y ADMIN se distinguen entre sÃ­ solo por
/// reportId, y derivarlo obligarÃ­a a un OR en cada consulta de bandeja. AdemÃ¡s
/// gobierna una regla de negocio: solo un ticket origin=USER puede cerrarlo el
/// propio usuario (T11) â€” si la administraciÃ³n abriÃ³ el hilo, no es suyo para
/// cerrarlo unilateralmente.
enum TicketOrigin {
  USER // (a) el usuario abriÃ³ el ticket
  ADMIN // (b) la administraciÃ³n iniciÃ³ el hilo
  REPORT // (c) derivado de un Report de moderaciÃ³n
}

/// Lado del que habla un mensaje del hilo. CONGELADO al escribir, NUNCA derivado
/// de author.role en lectura: un ADMIN tambiÃ©n puede abrir un ticket COMO usuario
/// sobre su propia cuenta, y el rol puede cambiar despuÃ©s (un moderador degradado
/// a USER no convierte retroactivamente sus respuestas en mensajes de usuario).
/// Mismo principio de congelaciÃ³n que Review.verified o los importes de Invoice.
enum TicketAuthorSide {
  USER
  STAFF
}

/// Hilo de atenciÃ³n al usuario.
model Ticket {
  id      String       @id @default(cuid())
  subject String
  status  TicketStatus @default(OPEN)
  origin  TicketOrigin

  /// Motivo/tema, molde ContactReason: configurable por admin, sin DELETE.
  /// Nullable porque un ticket de flujo ADMIN/REPORT puede no encajar en ninguno.
  /// Restrict, igual que ContactMessage.motivoId: un motivo con tickets no se borra
  /// (de todos modos no hay endpoint DELETE; se desactiva).
  topicId String?
  topic   ContactReason? @relation("TicketTopic", fields: [topicId], references: [id], onDelete: Restrict)

  /// EL USUARIO del hilo â€” siempre hay exactamente uno, sea quien sea que lo abriÃ³.
  /// Es la clave del owner-scope y el destinatario de las notificaciones (R4).
  userId String
  user   User   @relation("TicketUser", fields: [userId], references: [id], onDelete: Cascade)

  /// QuiÃ©n lo abriÃ³: el propio usuario (flujo a) o un miembro del staff (flujos b/c).
  /// Restrict (no Cascade): borrar la cuenta de un admin no puede borrar los hilos
  /// que abriÃ³ con usuarios â€” mismo criterio que Report.reporterId.
  openedById String
  openedBy   User   @relation("TicketOpener", fields: [openedById], references: [id])

  /// Agente que lo lleva. SetNull: si el agente deja de existir el hilo sigue vivo
  /// y vuelve a la bandeja sin asignar.
  assignedToId String?
  assignedTo   User?   @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  // --- Enlaces polimÃ³rficos (FKs nullables, molde Report â€” no (type,id)) ---
  // TODOS opcionales y TODOS SetNull: el hilo de atenciÃ³n al usuario NO puede
  // desaparecer porque se borre el anuncio/valoraciÃ³n/factura del que hablaba
  // (mismo criterio que Review.listingId / Deal.listingId).
  listingId String?
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  reviewId  String?
  review    Review?  @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  /// Flujo (c): el Report de moderaciÃ³n que originÃ³ este hilo. NO duplica el
  /// reporte â€” lo referencia. Report no se toca. Ver Â§8.3 del diseÃ±o.
  reportId String?
  report   Report? @relation(fields: [reportId], references: [id], onDelete: SetNull)

  /// Snapshot del contexto enlazado (tÃ­tulo del anuncio, nÃºmero de facturaâ€¦), molde
  /// Deal.listingTitle / Review.listingTitle: los SetNull de arriba dejarÃ­an el hilo
  /// sin contexto legible, y esta columna es lo que lo conserva.
  linkedLabel String?

  /// Denormalizado (molde Conversation.lastMessageAt): ordena la bandeja por
  /// "Ãºltimo movimiento" sin un MAX() sobre TicketMessage.
  lastMessageAt DateTime @default(now())

  resolvedAt DateTime?
  closedAt   DateTime?
  closedById String?
  closedBy   User?     @relation("TicketCloser", fields: [closedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages TicketMessage[]

  // Sin @@unique de (usuario, entidad): a diferencia de Conversation
  // (@@unique([listingId, buyerId])), un usuario puede tener legÃ­timamente dos
  // dudas distintas sobre el mismo anuncio â€” mismo criterio que Deal.
  @@index([userId, lastMessageAt]) // "mis tickets"
  @@index([status, lastMessageAt]) // bandeja de admin filtrada por estado
  @@index([assignedToId, status]) // "mis tickets asignados"
  @@index([reportId])
  @@index([listingId])
}

/// Mensaje del hilo. Append-only en la prÃ¡ctica: no hay ediciÃ³n ni borrado.
model TicketMessage {
  id       String @id @default(cuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("TicketMessageAuthor", fields: [authorId], references: [id])

  /// CONGELADO al escribir por el mÃ©todo que lo crea (replyAsUser â†’ USER,
  /// replyAsStaff â†’ STAFF). Nunca se recalcula desde author.role al leer.
  side TicketAuthorSide

  body String @db.Text

  /// NOTA INTERNA del staff: visible solo para ADMIN/MODERATOR, nunca para el
  /// usuario del hilo.
  ///
  /// APLAZADO (decisiÃ³n Â§14.3): en R1 la columna EXISTE pero NO HAY NINGUNA VÃA DE
  /// ESCRITURA â€” ningÃºn mÃ©todo de TicketsService la pone a true, y ningÃºn DTO la
  /// acepta. Lo que sÃ­ estÃ¡ ya puesto es la PRIMERA CAPA de la invariante de
  /// privacidad (Â§10.3): getForUser filtra `internal: false` en la propia query,
  /// desde antes de que exista nada que filtrar. Precedente que lo justifica:
  /// Listing.phone, que un findUnique({include}) sin select habrÃ­a publicado en el
  /// JSON pÃºblico de la ficha.
  internal Boolean @default(false)

  /// Acuse de lectura por lado. Dos columnas y no un Ãºnico readAt: el hilo tiene
  /// dos lados con contadores de "sin leer" independientes (el del usuario y el de
  /// la bandeja de staff).
  readByUserAt  DateTime?
  readByStaffAt DateTime?

  createdAt DateTime @default(now())

  attachments TicketAttachment[]

  @@index([ticketId, createdAt]) // molde Message â€” paginaciÃ³n por cursor sobre createdAt
}

/// Adjunto de un mensaje. Molde FACTURA (R2 privado), NO molde media (R2 pÃºblico):
/// se guarda la CLAVE, nunca una URL â€” el fichero se sirve por un endpoint
/// autenticado que revalida el acceso al ticket. Un pantallazo de un problema puede
/// llevar datos personales, y una URL pÃºblica de R2 es compartible y no revocable.
/// El modelo va en R1 para no partir la migraciÃ³n en dos; la SUBIDA real es R5.
model TicketAttachment {
  id              String        @id @default(cuid())
  ticketMessageId String
  message         TicketMessage @relation(fields: [ticketMessageId], references: [id], onDelete: Cascade)

  /// Clave privada en R2: `tickets/<ticketId>/<randomBytes(16)>.<ext>`.
  /// NUNCA el nombre original del cliente (molde MediaService).
  key String

  /// Nombre original, solo para mostrar y para el Content-Disposition. Nunca se usa
  /// para construir la clave ni ninguna ruta.
  filename  String
  mimeType  String
  sizeBytes Int
  createdAt DateTime @default(now())

  @@index([ticketMessageId])
}

// ============================================================================
//  PORTADA CONFIGURABLE (RP.1) — configuración global de la home (/).
//  Fila ÚNICA. Motor de bloques PROPIO, hermano del de Post.blocks pero
//  independiente: la portada tiene tipos que una página informativa nunca debe
//  tener (buscador, tabla de búsquedas) y un hero que el blog no tiene.
//  Ver docs/diseno-portada.md §2.
// ============================================================================

/// Configuración de la portada. UNA sola fila, sin borrador/publicado: lo que
/// hay guardado es lo que se sirve.
///
/// POR QUÉ TABLA PROPIA Y NO UNA `Setting` MÁS (diseño §2.1): `Setting.value`
/// es un Json opaco por construcción —el tipo depende de la clave y NINGÚN DTO
/// lo valida campo a campo—. Aquí hay `href` y `src` que acaban en atributos
/// reales del DOM, que es exactamente lo que `@IsSafeContentUrl`/
/// `@IsOwnStorageUrl` existen para vigilar. Mismo criterio por el que NavItem
/// no reusó FooterItem: dos sistemas que deben poder divergir no comparten tabla.
model HomepageConfig {
  /// Fila única. El servicio SIEMPRE hace upsert sobre este id y nunca expone
  /// create ni delete, así que "exactamente una fila" no depende de la
  /// disciplina de nadie. Sembrada en seed.ts y en seed-test.ts.
  id String @id @default("singleton")

  // ── HERO ─────────────────────────────────────────────────────────────────
  // Campos propios, FUERA del array de bloques: el hero es la única pieza de la
  // portada cuyo comportamiento depende de su posición, y sacarlo del array es
  // lo que permite que ningún bloque conozca su índice (diseño §2.3). Se paga
  // con que el hero no se puede reordenar — que es justo lo que se quiere.

  /// Parte FIJA del <h1>. Obligatoria y no vacía: la portada SIEMPRE tiene un
  /// <h1> con texto real. "No tener título" no es configurable (SEO).
  heroStaticTitle String

  /// Opciones que rotan tras la parte fija. [] = título totalmente estático,
  /// sin animación (caso degenerado soportado, no un error). Tope 6 en el DTO
  /// — el tope NO es estético: es la consecuencia de resolver la rotación en
  /// CSS puro (diseño §3.2), que necesita una regla @keyframes ESTÁTICA por
  /// cada N soportado porque un selector de keyframe no admite calc().
  heroRotatingOptions String[] @default([])

  /// Milisegundos que cada opción permanece visible. Acotado en el DTO
  /// [1500, 10000]: por debajo es ilegible, por encima parece rota.
  heroRotationMs Int @default(3000)

  /// Subtítulo bajo el <h1>. Texto PLANO, no markdown — un párrafo bajo un
  /// titular no justifica abrir la tubería de sanitización (react-markdown +
  /// rehype-sanitize), y no abrirla es una superficie de seguridad menos.
  heroSubtitle String?

  // ── BLOQUES ──────────────────────────────────────────────────────────────

  /// Array ORDENADO (la posición ES el orden, no hay campo `order` por bloque,
  /// igual que Post.blocks) de objetos { id, type, ...datos }, unión
  /// discriminada por `type`. 7 tipos previstos (search, categoryCarousel,
  /// grid, steps, cta, listings, searchTable); RP.1 implementa los DTOs de
  /// `cta` y `search`, el resto entra en RP.4-RP.6.
  /// Validado en profundidad en el DTO (discriminador class-transformer) y en
  /// el servicio (reglas cruzadas que dependen del array completo o de estado
  /// externo — ver HomepageService.assertBlocksValid).
  blocks Json @default("[]")

  updatedAt DateTime @updatedAt

  /// Admin que guardó por última vez (null en el seed inicial), igual que
  /// Setting.updatedById. Sin relación a User a propósito: si se borrase la
  /// cuenta del admin no debe arrastrar ni bloquear la config de la portada.
  updatedById String?
}
