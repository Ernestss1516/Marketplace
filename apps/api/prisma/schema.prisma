// ============================================================================
//  schema.prisma — Modelo de datos del marketplace (PostgreSQL)
//  Fuente única de verdad de la persistencia. Lo consume NestJS vía PrismaClient.
// ============================================================================

generator client {
  provider = "prisma-client-js"
  // postgresqlExtensions habilita extensiones de Postgres (p. ej. PostGIS) desde el schema.
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // PostGIS para búsquedas geográficas por radio (ver nota en el modelo Listing).
  extensions = [postgis]
}

// ============================================================================
//  ENUMS
// ============================================================================

/// Estado de un post de blog.
enum PostStatus {
  DRAFT       // Borrador, no visible públicamente
  PUBLISHED   // Publicado, indexado en sitemap
}

/// Rol del usuario. Gobierna el acceso al backoffice (RolesGuard en NestJS).
enum Role {
  USER
  MODERATOR
  ADMIN
}

/// Estado de la cuenta de usuario.
enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

/// Ciclo de vida de un anuncio. Modela el flujo de publicación y moderación.
enum ListingStatus {
  DRAFT           // Borrador, aún no enviado
  PENDING_REVIEW  // En espera de moderación
  ACTIVE          // Publicado y visible
  RESERVED        // Reservado a un comprador
  SOLD            // Vendido
  EXPIRED         // Caducado
  REJECTED        // Rechazado por moderación
}

/// Un anuncio puede ofrecer un producto o un servicio.
enum ListingType {
  PRODUCT
  SERVICE
}

/// Estado del artículo (aplica sobre todo a productos).
enum Condition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  FOR_PARTS
}

/// Tipo de precio de un anuncio.
enum PriceType {
  FIXED       // Precio fijo
  FREE        // Gratis (price = 0)
  NEGOTIABLE  // A convenir
}

// ============================================================================
//  ENUMS DE FACTURACIÓN
// ============================================================================

enum ProductType {
  ONE_TIME   // Pago único (destacado de anuncio)
  RECURRING  // Suscripción recurrente (Plan Pro)
}

enum PriceInterval {
  MONTH
  YEAR
}

enum SubscriptionStatus {
  ACTIVE     // Activa y se renovará automáticamente
  CANCELING  // Cancelada por el usuario; sigue activa hasta currentPeriodEnd
  CANCELED   // Expirada definitivamente
  PAST_DUE   // Pago fallido; en período de reintento por la pasarela
}

enum TransactionStatus {
  PENDING            // Esperando confirmación de la pasarela
  SUCCEEDED          // Cobro confirmado
  FAILED             // Cobro fallido definitivamente
  REFUNDED           // Devuelto íntegramente
  PARTIALLY_REFUNDED
}

enum EntitlementType {
  PRO_SUBSCRIPTION  // Acceso al Plan Pro (nivel de usuario)
  FEATURED_LISTING  // Anuncio destacado (nivel de anuncio)
}

/// Origen de un Entitlement FEATURED_LISTING (H8.1). Distingue las dos bolsas
/// de destacados: la cuota mensual gratis de Pro (PRO_QUOTA, caduca con el
/// periodo de facturación — ver EntitlementService en H8.2) de los destacados
/// adquiridos por créditos o pago directo (no caducan). Irrelevante para
/// PRO_SUBSCRIPTION.
enum FeaturedOrigin {
  CREDITS    // featuredByCredits — débito de Wallet
  REDSYS     // pago directo vía Redsys
  PRO_QUOTA  // cuota mensual gratis de Pro
}

enum CreditLedgerType {
  PACK_PURCHASE   // Compra de pack de créditos → entrada (positivo)
  FEATURED_DEBIT  // Destacado pagado con créditos → salida (negativo)
  BUMP_DEBIT      // Bump pagado con créditos → salida (negativo)
  ADMIN_CREDIT    // Acreditación manual de soporte → entrada
  ADMIN_DEBIT     // Débito manual de soporte → salida
  PRO_BONUS       // Créditos extra concedidos a usuarios Pro al comprar un pack → entrada
  CAMPAIGN_BONUS  // Créditos extra concedidos por una campaña promocional al comprar un pack → entrada
}

/// Tipo de campaña promocional (H8 Bloque D). Extensible sin migración de datos:
/// los parámetros concretos de cada tipo viven en Campaign.params (jsonb), no en
/// columnas propias. Futuro: ACTION_DISCOUNT (descuento en bump/destacar, fase 2),
/// COUPON (cupón canjeable, fase 3), BANNER (difusión, fase 4).
enum CampaignType {
  CREDIT_BONUS  // Bonus de créditos al comprar un pack
}

/// Motivo de una denuncia, para la cola de moderación.
enum ReportReason {
  SPAM
  FRAUD
  INAPPROPRIATE
  PROHIBITED_ITEM
  WRONG_CATEGORY
  FAKE_REVIEW
  OTHER
}

/// Estado de gestión de una denuncia.
enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  DISMISSED
}

// ============================================================================
//  USUARIOS
// ============================================================================

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  /// Null para usuarios que solo entran vía login social (Google, etc.)
  passwordHash  String?
  name          String
  /// Slug único para la URL del perfil público (SEO): /vendedor/{slug}
  slug          String     @unique
  phone         String?
  avatarUrl     String?
  bio           String?    @db.Text
  role          Role       @default(USER)
  status        UserStatus @default(ACTIVE)
  emailVerified Boolean    @default(false)
  /// H8 Bloque E — "Vendedor de confianza": confianza otorgada por la plataforma (ADMIN-only).
  /// Independiente de Pro (isProActive): un usuario puede ser Pro, de confianza, ambos o ninguno.
  trusted       Boolean    @default(false)

  // Ubicación para mostrar y prefiltrar
  city          String?
  province      String?
  postalCode    String?

  /// Referencia al Customer de Stripe; null hasta el primer pago
  stripeCustomerId String? @unique

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // --- Relaciones ---
  listings            Listing[]
  favorites           Favorite[]
  buyerConvos         Conversation[]      @relation("BuyerConversations")
  sellerConvos        Conversation[]      @relation("SellerConversations")
  messages            Message[]
  reviewsAuthored     Review[]            @relation("ReviewAuthor")
  reviewsReceived     Review[]            @relation("ReviewTarget")
  reportsMade         Report[]            @relation("Reporter")
  reportsReceived     Report[]            @relation("ReportedUser")
  reportsResolved     Report[]            @relation("ReportResolver")
  verificationTokens  VerificationToken[]
  passwordResetTokens PasswordResetToken[]
  accounts            Account[]
  uploadedImages      ListingImage[]       @relation("UploadedImages")
  auditLogsActed      AuditLog[]           @relation("AuditLogActor")
  posts               Post[]               @relation("PostAuthor")
  entitlements        Entitlement[]
  subscriptions       Subscription[]
  transactions        Transaction[]
  wallet              Wallet?

  @@index([status])
}

/// Vincula un User con una identidad de proveedor externo (login social).
/// Un User puede tener varias (Google, y en el futuro Facebook/Apple).
model Account {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 'google'; futuro: 'facebook', 'apple'
  provider          String
  /// Identificador estable del usuario en el proveedor (p. ej. el `sub` de Google)
  providerAccountId String
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// ============================================================================
//  CATEGORÍAS (árbol jerárquico autorreferenciado)
// ============================================================================

model Category {
  id        String  @id @default(cuid())
  name      String
  /// Slug único para la URL de listado (SEO): /{slug}
  slug      String  @unique
  iconUrl   String?
  order     Int     @default(0)

  // Auto-relación: una categoría puede tener una categoría padre y subcategorías.
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")

  /// Definición de los atributos esperados para esta categoría (nombre, tipo,
  /// opciones, si es filtrable…). El frontend la usa para pintar el formulario
  /// de publicación y los filtros; los valores concretos viven en Listing.attributes.
  attributeSchema Json @default("[]")

  listings  Listing[]

  @@index([parentId])
}

// ============================================================================
//  ANUNCIOS (núcleo del dominio)
// ============================================================================

model Listing {
  id          String        @id @default(cuid())
  title       String
  /// Slug único para la ficha (SEO): /anuncio/{slug}
  slug        String        @unique
  description String        @db.Text

  // Decimal (no Float) para evitar errores de redondeo en importes monetarios.
  price       Decimal       @db.Decimal(12, 2)
  currency    String        @default("EUR")

  type        ListingType
  condition   Condition?    // Nulo en servicios
  priceType   PriceType     @default(FIXED)
  status      ListingStatus @default(DRAFT)

  /// jsonb con los atributos variables según la categoría.
  /// Coche → { km, año, combustible, cambio }; Inmueble → { m2, habitaciones, planta }…
  /// Evita una tabla de columnas distintas por categoría. La búsqueda y el filtrado
  /// fino de estos campos se delegan en Meilisearch.
  attributes  Json          @default("{}")

  // --- Ubicación ---
  city        String?
  province    String?
  postalCode  String?
  latitude    Float?
  longitude   Float?
  // NOTA PostGIS: para búsquedas por radio eficientes ("anuncios a 10 km") se
  // añade en una migración SQL una columna geography(Point, 4326) con índice GiST,
  // poblada desde latitude/longitude. Prisma la trata como campo no gestionado.

  viewCount   Int           @default(0)

  publishedAt DateTime?
  expiresAt   DateTime?
  bumpedAt    DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // --- Relaciones ---
  sellerId    String
  seller      User          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id])

  images        ListingImage[]
  favorites     Favorite[]
  conversations Conversation[]
  reports       Report[]
  reviews       Review[]
  entitlements  Entitlement[]
  transactions  Transaction[]
  viewsDaily    ListingViewDaily[]

  // Índices para los filtros y ordenaciones más frecuentes (rendimiento de listados).
  @@index([categoryId, status])
  @@index([status, publishedAt])
  @@index([sellerId])
  @@index([price])
  @@index([province, city])
}

model ListingImage {
  id        String   @id @default(cuid())
  url       String
  alt       String?
  width     Int?
  height    Int?
  order     Int      @default(0)

  listingId    String?
  listing      Listing? @relation(fields: [listingId], references: [id], onDelete: Cascade)

  uploadedById String?
  uploadedBy   User?    @relation("UploadedImages", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([listingId])
  @@index([uploadedById])
}

// ============================================================================
//  FAVORITOS
// ============================================================================

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  // Un usuario no puede marcar el mismo anuncio dos veces.
  @@unique([userId, listingId])
  @@index([userId])
}

/// H8 Bloque C1 — agregado diario de vistas de un anuncio (no un evento por
/// vista). El total (free) sigue viviendo en Listing.viewCount; esta tabla
/// solo aporta la granularidad temporal para la gráfica Pro (GROUP BY date).
model ListingViewDaily {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  count     Int      @default(0)

  @@unique([listingId, date])
  @@index([listingId])
}

// ============================================================================
//  MENSAJERÍA (conversación por anuncio entre comprador y vendedor)
// ============================================================================

model Conversation {
  id            String    @id @default(cuid())
  listingId     String
  listing       Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId       String
  buyer         User      @relation("BuyerConversations", fields: [buyerId], references: [id])
  sellerId      String
  seller        User      @relation("SellerConversations", fields: [sellerId], references: [id])

  lastMessageAt DateTime  @default(now())
  createdAt     DateTime  @default(now())

  messages      Message[]

  // Una sola conversación por (anuncio, comprador).
  @@unique([listingId, buyerId])
  @@index([buyerId])
  @@index([sellerId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  body           String       @db.Text
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

// ============================================================================
//  VALORACIONES (reputación)
// ============================================================================

model Review {
  id        String    @id @default(cuid())
  rating    Int       // 1..5 (validado en el DTO)
  comment   String?   @db.Text

  authorId  String
  author    User      @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  targetId  String
  target    User      @relation("ReviewTarget", fields: [targetId], references: [id], onDelete: Cascade)
  // Nullable: la reseña sobrevive al borrado del anuncio (la reputación no es
  // borrable por el vendedor); listingId pasa a NULL, análogo a
  // Entitlement/Transaction. listingTitle conserva el contexto.
  listingId String?
  listing   Listing?  @relation(fields: [listingId], references: [id], onDelete: SetNull)
  // Snapshot del título del anuncio en el momento de crear la reseña, para que
  // el listado público pueda mostrar contexto aunque el anuncio se borre después.
  listingTitle String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  // null hasta la primera edición; frontend muestra indicador "Editada" cuando no es null
  editedAt  DateTime?

  reports   Report[]

  // [authorId, targetId, listingId] permite bidireccionalidad:
  // buyer→seller y seller→buyer son filas distintas sobre el mismo anuncio.
  @@unique([authorId, targetId, listingId])
  @@index([targetId])
  @@index([listingId])
}

// ============================================================================
//  MODERACIÓN (denuncias)
// ============================================================================

model Report {
  id             String       @id @default(cuid())
  reason         ReportReason
  description    String?      @db.Text
  status         ReportStatus @default(PENDING)

  reporterId     String
  reporter       User         @relation("Reporter", fields: [reporterId], references: [id])

  // Una denuncia apunta a un anuncio o a un usuario (al menos uno).
  listingId      String?
  listing        Listing?     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reportedUserId String?
  reportedUser   User?        @relation("ReportedUser", fields: [reportedUserId], references: [id])

  // Auditoría de la resolución por parte de un moderador.
  resolvedById   String?
  resolvedBy     User?        @relation("ReportResolver", fields: [resolvedById], references: [id])
  resolvedAt     DateTime?

  // Una denuncia puede apuntar a una valoración (además de a listing o user)
  reviewId       String?
  review         Review?      @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  createdAt      DateTime     @default(now())

  @@index([status])
  @@index([listingId])
  @@index([reviewId])
}

// ============================================================================
//  AUDITORÍA (backoffice)
// ============================================================================

/// Registro inmutable de cada acción administrativa sensible.
/// DECISIÓN DE DISEÑO: capturado mediante AuditLogService inyectado en el
/// service de dominio, NUNCA con un interceptor de NestJS. El interceptor no
/// tiene acceso al estado de Prisma antes de la mutación (el campo `before`
/// requiere leer el recurso justo antes de modificarlo, dentro del service).
model AuditLog {
  id           String   @id @default(cuid())

  /// Convención SCREAMING_SNAKE_CASE:
  /// LISTING_DEACTIVATE | LISTING_RESTORE | LISTING_APPROVE | LISTING_REJECT
  /// USER_SUSPEND | USER_BAN | USER_REINSTATE | USER_ROLE_CHANGE
  /// REPORT_RESOLVE | REPORT_DISMISS
  /// CATEGORY_CREATE | CATEGORY_EDIT | CATEGORY_DELETE | CATEGORY_REORDER
  /// SETTING_UPDATE
  action       String

  actorId      String
  actor        User     @relation("AuditLogActor", fields: [actorId], references: [id])

  /// "Listing" | "User" | "Report" | "Category" | "Setting"
  resourceType String
  resourceId   String

  /// Snapshot del estado ANTES de la mutación. Null si no aplica (p.ej. primera
  /// escritura de un Setting).
  before       Json?

  /// Snapshot del estado DESPUÉS de la mutación.
  after        Json?

  /// IP del actor para auditoría de seguridad (extraída del request).
  ip           String?

  createdAt    DateTime @default(now())

  @@index([actorId])
  @@index([resourceType, resourceId])
  @@index([createdAt])
}

// ============================================================================
//  AJUSTES DEL SISTEMA (backoffice)
// ============================================================================

/// Configuración del sistema editable desde el backoffice sin despliegue.
/// Keys conocidas: badWordList (string[]), listingExpiryDays (number),
/// contactRequiresVerification (boolean).
/// Sembradas en seed.ts con createMany + skipDuplicates para no pisar valores
/// que el admin haya cambiado manualmente.
model Setting {
  /// Clave única del ajuste (ej. "badWordList").
  key          String   @id

  /// Valor serializado como JSON. El tipo concreto depende de la key.
  value        Json

  updatedAt    DateTime @updatedAt

  /// ID del admin que actualizó el ajuste por última vez (null en seed inicial).
  updatedById  String?
}

// ============================================================================
//  AUTH TOKENS (verificación de email y recuperación de contraseña)
// ============================================================================

model VerificationToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ============================================================================
//  FACTURACIÓN
// ============================================================================

/// Producto comercial. Los precios concretos viven en Price.
/// Los productos no se eliminan físicamente; se desactivan (active = false).
model Product {
  id          String      @id @default(cuid())
  name        String
  description String?     @db.Text
  type        ProductType

  /// Cuando active=false, el producto no se ofrece en nuevas compras
  /// pero sus Prices y Entitlements existentes siguen vigentes.
  active      Boolean     @default(true)

  prices      Price[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

/// Variante de precio de un producto. Una variante = una opción de compra.
model Price {
  id            String         @id @default(cuid())
  productId     String
  product       Product        @relation(fields: [productId], references: [id])

  amount        Decimal        @db.Decimal(10, 2)
  currency      String         @default("EUR")

  // Solo para RECURRING
  interval      PriceInterval?
  intervalCount Int?           @default(1)

  // Solo para ONE_TIME (destacado)
  durationDays  Int?

  /// ID del objeto equivalente en la pasarela (Stripe Price ID).
  gatewayPriceId String?       @unique

  /// FK al CreditPack asociado; solo presente en Prices de packs de créditos.
  creditPackId  String?        @unique
  creditPack    CreditPack?    @relation(fields: [creditPackId], references: [id])

  active        Boolean        @default(true)

  transactions  Transaction[]
  subscriptions Subscription[]
  entitlements  Entitlement[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([productId])
}

/// Registro de un derecho activo. Es la única tabla que lee la lógica de negocio
/// para decidir si un usuario puede hacer algo. No conoce la pasarela.
///
/// Un entitlement es VIGENTE cuando:
///   revokedAt IS NULL AND (expiresAt IS NULL OR expiresAt > now())
///
/// revokedAt se setea en dos casos:
///   1. El cron de expiración procesa un FEATURED_LISTING caducado (B.1) — garantiza
///      que cada destacado expirado se reindexe exactamente una vez.
///   2. Un administrador revoca manualmente un entitlement aún no caducado (futuro).
/// Nunca se borra una fila de esta tabla; la revocación es el mecanismo de cierre.
model Entitlement {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  type           EntitlementType

  /// Solo para FEATURED_LISTING: de qué bolsa salió (cuota Pro vs. adquirido).
  /// Null para PRO_SUBSCRIPTION. Backfill H8.1: transactionId presente → REDSYS,
  /// ausente → CREDITS (así se distinguían ya antes de existir este campo).
  origin         FeaturedOrigin?

  /// Solo para FEATURED_LISTING: anuncio al que aplica el boost.
  listingId      String?
  listing        Listing?        @relation(fields: [listingId], references: [id], onDelete: SetNull)

  startsAt       DateTime        @default(now())
  /// Null = sin caducidad (reservado para créditos manuales de soporte).
  expiresAt      DateTime?

  /// Seteado cuando el entitlement se revoca explícitamente (cron de expiración de
  /// FEATURED_LISTING, o revocación manual de admin). Un entitlement con revokedAt
  /// seteado NO cuenta como vigente aunque expiresAt sea futuro.
  revokedAt      DateTime?

  // Trazabilidad del origen
  priceId        String?
  price          Price?          @relation(fields: [priceId], references: [id])
  transactionId  String?
  transaction    Transaction?    @relation(fields: [transactionId], references: [id])
  subscriptionId String?
  subscription   Subscription?   @relation(fields: [subscriptionId], references: [id])

  createdAt      DateTime        @default(now())

  @@index([userId, type])
  @@index([userId, type, origin, createdAt])
  @@index([listingId])
  @@index([expiresAt])
  @@index([revokedAt])
}

/// Estado de una suscripción recurrente. Una sola suscripción activa por usuario.
model Subscription {
  id                    String             @id @default(cuid())
  userId                String
  user                  User               @relation(fields: [userId], references: [id], onDelete: Restrict)

  priceId               String
  price                 Price              @relation(fields: [priceId], references: [id])

  status                SubscriptionStatus @default(ACTIVE)

  currentPeriodStart    DateTime
  currentPeriodEnd      DateTime

  cancelAtPeriodEnd     Boolean            @default(false)
  canceledAt            DateTime?

  /// ID de la suscripción en Stripe. Inmutable tras la creación.
  gatewaySubscriptionId String             @unique

  entitlements          Entitlement[]
  transactions          Transaction[]

  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([userId])
  @@index([status])
  @@index([currentPeriodEnd])
}

/// Registro permanente de cada cobro. NUNCA se borra ni se modifica el importe.
model Transaction {
  id           String            @id @default(cuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Restrict)

  priceId      String
  price        Price             @relation(fields: [priceId], references: [id])

  amountGross  Decimal           @db.Decimal(10, 2)
  amountNet    Decimal           @db.Decimal(10, 2)
  taxAmount    Decimal           @db.Decimal(10, 2)
  taxRate      Decimal           @db.Decimal(5, 4)
  currency     String            @default("EUR")

  status       TransactionStatus @default(PENDING)

  /// Pasarela que procesó el cobro. "STRIPE" | "REDSYS"
  gateway      String            @default("STRIPE")

  /// Referencias de la pasarela. NUNCA se almacenan PANs, CVVs ni datos de tarjeta.
  gatewayPaymentIntentId String?  @unique
  gatewayInvoiceId       String?  @unique
  gatewayChargeId        String?

  invoiceNumber  String?
  invoiceUrl     String?

  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

  /// Solo en destacados: anuncio al que corresponde el cobro.
  listingId      String?
  listing        Listing?      @relation(fields: [listingId], references: [id], onDelete: SetNull)

  entitlements   Entitlement[]

  /// Créditos extra congelados en el checkout para usuarios Pro. Null = sin bonus.
  /// Calculado en createCreditPackCheckout; el RedsysProcessor lo lee sin recalcular.
  bonusCreditAmount Int?

  /// Bonus de campaña promocional congelado en el checkout (H8 Bloque D). Null = sin
  /// campaña activa en ese instante. Se SUMA a bonusCreditAmount (Pro + campaña), no
  /// lo sustituye. El RedsysProcessor lo lee sin recalcular — el bonus vigente es el
  /// del instante del checkout, no el de la confirmación del pago.
  campaignBonusAmount Int?
  /// Campaña que originó campaignBonusAmount, para trazabilidad/reporting. Las
  /// campañas no se borran (solo se desactivan), pero SetNull es red de seguridad.
  campaignId          String?
  campaign            Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

/// Tabla de registro de eventos ya procesados de la pasarela.
/// Garantiza que un webhook duplicado no tenga efectos secundarios.
/// Solo se escribe; nunca se actualiza ni se borra.
model GatewayEvent {
  id             String   @id @default(cuid())

  /// ID único del evento en la pasarela (p.ej. "evt_1ABC..." en Stripe; Ds_Order en Redsys).
  gatewayEventId String   @unique

  eventType      String

  /// "STRIPE" | "REDSYS" — distingue el origen del evento para trazabilidad.
  gateway        String   @default("STRIPE")

  processedAt    DateTime @default(now())

  @@index([processedAt])
}

// ============================================================================
//  WALLET Y CRÉDITOS
// ============================================================================

/// Pack de créditos comprable. El precio en EUR vive en el Price asociado (creditPackId).
/// Los costes de gastar créditos (featured, bump) viven en Setting.
model CreditPack {
  id           String   @id @default(cuid())
  name         String
  description  String?  @db.Text
  /// Créditos que el usuario recibe al comprar este pack.
  creditAmount Int
  active       Boolean  @default(true)

  /// Relación inversa: el Price asociado apunta a este pack vía creditPackId.
  price        Price?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Saldo de créditos de un usuario. Una fila por usuario.
///
/// INVARIANTE: balance >= 0. Nunca se vuelve negativo.
/// El débito atómico via UPDATE ... WHERE balance >= N garantiza este invariante
/// sin serializable isolation. Ver diseno-facturacion.md §3.2 para el patrón.
model Wallet {
  id        String         @id @default(cuid())
  userId    String         @unique
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Saldo en créditos enteros. Fuente de verdad del saldo actual.
  balance   Int            @default(0)

  entries   CreditLedger[]

  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

/// Registro inmutable de cada movimiento de créditos.
/// NUNCA se modifica ni se borra una fila de esta tabla.
/// amount > 0 = crédito (suma); amount < 0 = débito (resta).
model CreditLedger {
  id            String           @id @default(cuid())
  walletId      String
  wallet        Wallet           @relation(fields: [walletId], references: [id])

  type          CreditLedgerType

  /// Positivo = crédito (suma al saldo); negativo = débito (resta al saldo).
  amount        Int

  /// Referencia polimórfica al recurso que originó el movimiento.
  /// Transaction.id para compras; Entitlement.id para destacados; Listing.id para bumps.
  referenceId   String?
  referenceType String?          // "Transaction" | "Entitlement" | "Listing"

  note          String?

  createdAt     DateTime         @default(now())

  @@index([walletId])
  @@index([createdAt])
}

/// Campaña promocional gestionada desde el backoffice (H8 Bloque D fase 1).
/// El MOTOR es genérico y extensible a descuentos/cupones/difusión (fases 2-4);
/// esta fase solo implementa CREDIT_BONUS.
///
/// Decisión de producto: no se permiten dos campañas ACTIVE del MISMO type con
/// fechas solapadas (validado en CampaignsService al crear/editar). Así nunca
/// hay ambigüedad de "cuál aplicar" — a lo sumo una campaña de un type dado está
/// vigente en un instante dado. Campañas de types distintos sí pueden convivir.
model Campaign {
  id        String       @id @default(cuid())
  name      String
  type      CampaignType
  active    Boolean      @default(true)
  startsAt  DateTime
  endsAt    DateTime

  /// Parámetros específicos del type. Para CREDIT_BONUS:
  /// { "kind": "PERCENT" | "FIXED", "value": number }
  /// Validado en el DTO según `type`, no a nivel de BD (mismo patrón que
  /// Setting.value / Listing.attributes) — evita migración por cada type nuevo.
  params    Json

  transactions Transaction[]

  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([type, active, startsAt, endsAt])
}

// ============================================================================
//  BLOG
// ============================================================================

/// Post editorial del blog, gestionado exclusivamente desde el backoffice admin.
/// El cuerpo se almacena como Markdown raw; la conversión a HTML ocurre en el
/// frontend (react-markdown + rehype-sanitize) para evitar XSS almacenado.
model Post {
  id              String     @id @default(cuid())
  title           String
  /// Slug único para la URL pública: /blog/{slug}
  slug            String     @unique
  /// Resumen corto: aparece en tarjetas de listado y como meta description fallback.
  excerpt         String?    @db.Text
  /// Cuerpo en Markdown raw.
  body            String     @db.Text @default("")
  status          PostStatus @default(DRAFT)
  /// URL de la imagen de portada (obtenida vía POST /media/upload).
  coverUrl        String?
  /// Overrides SEO opcionales; si son null se usan title/excerpt como fallback.
  metaTitle       String?
  metaDescription String?    @db.Text
  /// Etiquetas planas como slugs (p.ej. ["consejos", "segunda-mano"]).
  tags            String[]   @default([])
  authorId        String
  author          User       @relation("PostAuthor", fields: [authorId], references: [id])
  publishedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([status, publishedAt])
}
