# Plantilla del entorno de TEST. Copiar a `.env.test` (ignorado por Git) en cada
# máquina:  cp apps/api/.env.test.example apps/api/.env.test
#
# El `.env.test` real NO se versiona: llegó a tener claves reales en un
# repositorio público. En CI no hace falta ningún fichero — el workflow define
# todas estas variables en su bloque `env:` (ver .github/workflows/ci.yml), y
# dotenv nunca pisa lo que ya está en process.env.
#
# IMPORTANTE (Windows + Docker Desktop): usar 127.0.0.1, NUNCA localhost, en las
# conexiones a los contenedores. Node resuelve "localhost" a ::1 primero, y el
# reenvío de puertos IPv6 de Docker Desktop acepta el connect y corta al primer
# byte -> ECONNRESET/ECONNABORTED (errno -4077/-4079) en bucle. Ver CLAUDE.md.

# Base de datos — el nombre DEBE contener "_test" (lo exige el schema de Joi,
# para no escribir jamás sobre la base de datos de desarrollo).
DATABASE_URL="postgresql://marketplace:marketplace_dev@127.0.0.1:5432/marketplace_test"

# Redis — db 1, aislada de la db 0 de desarrollo (mismo servidor). El schema de
# Joi exige una db distinta de 0 en test: si no, la batería e2e se comería los
# jobs de BullMQ, los contadores de rate-limit y las cachés del servidor de dev.
REDIS_URL="redis://127.0.0.1:6379/1"

# Meilisearch: misma instancia, índice dedicado. El nombre DEBE contener "_test".
MEILI_HOST="http://127.0.0.1:7700"
MEILI_MASTER_KEY="masterKey_dev_change_me"
MEILI_INDEX_NAME="listings_test"

# Autenticación
JWT_SECRET="test_jwt_secret_change_me"
JWT_EXPIRES_IN="7d"

# Almacenamiento de imágenes (MinIO local)
S3_ENDPOINT="http://127.0.0.1:9000"
S3_BUCKET="marketplace-test"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_PUBLIC_URL="http://127.0.0.1:9000/marketplace-test"

# Email (Resend) — los tests no envían correo de verdad.
RESEND_API_KEY="re_test_dummy_key"
RESEND_FROM="noreply@example.com"

# URLs
APP_URL="http://localhost:3000"

# ISR revalidación on-demand: debe coincidir con REVALIDATE_SECRET de apps/web.
REVALIDATE_SECRET="change_me_same_as_web"

# App
PORT=3001
NODE_ENV=test

# Geocoding
GEOCODING_PROVIDER=nominatim

# Stripe — NUNCA poner aquí una clave real: este fichero SÍ se versiona.
# Los tests no llaman a la API de Stripe; estos valores solo satisfacen la
# validación. Las claves reales van en el `.env.test` local, que está ignorado.
STRIPE_SECRET_KEY=sk_test_your_stripe_test_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here
STRIPE_PRICE_FEATURED_7D=price_...
STRIPE_PRICE_FEATURED_14D=price_...
STRIPE_PRICE_FEATURED_30D=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...

# Redsys — valores ficticios; el TPV real no se toca en los tests.
REDSYS_MERCHANT_CODE=999008881
REDSYS_TERMINAL=001
# OJO CON EL FORMATO: redsys.e2e-spec.ts firma de verdad (sin mocks) y comprueba
# que Ds_Signature mide 44 caracteres. redsys-easy decodifica esta clave como
# base64 y la usa con 3DES (des-ede3-cbc), que exige EXACTAMENTE 24 bytes. Un
# valor suelto decodifica a otra longitud y revienta con "Invalid key length".
# Éste es base64 de "ci_redsys_dummy_key_2026" — 24 bytes justos.
REDSYS_SECRET_KEY=Y2lfcmVkc3lzX2R1bW15X2tleV8yMDI2
REDSYS_ENVIRONMENT=test
REDSYS_NOTIFICATION_URL=

# Login social Google — ficticio: los tests mockean google-auth-library.
GOOGLE_CLIENT_ID=test-google-client-id.apps.googleusercontent.com

# Observabilidad — vacío desactiva el SDK.
SENTRY_DSN=

# Formulario de contacto público (RC.1) — el schema de Joi exige mínimo 16 chars.
CONTACT_FORM_SECRET="test_contact_form_secret_do_not_use_in_prod"
TRUST_PROXY_HOPS=1
